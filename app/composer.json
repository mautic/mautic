        "type": "library",
        "source": {
          "type": "git",
          "url": "https://github.com/lightsaml2/lightSAML.git",
          "reference": "b0743e4051ea9bc71d53024871526c930305a6c5"
        },
        "dist": {
          "type": "zip",
          "url": "https://api.github.com/repos/lightsaml2/lightSAML/zipball/b0743e4051ea9bc71d53024871526c930305a6c5",
          "reference": "b0743e4051ea9bc71d53024871526c930305a6c5"
