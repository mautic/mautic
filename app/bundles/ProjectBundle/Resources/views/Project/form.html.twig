{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent 'project' %}

{% block headerTitle %}
    {% if form.vars.data.id %}
        {{ 'mautic.project.menu.edit'|trans({'%name%': entity.getName()}) }}
    {% else %}
        {{ 'mautic.project.menu.new'|trans }}
    {% endif %}
{% endblock %}

{% block content %}
{% set projectTabContent %}
                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.name) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.description) }}
                                </div>
                            </div>
{% endset %}
    {{ form_start(form) }}

    <div class="box-layout">
        <div class="col-md-9 height-auto">
            <div class="row">
                <div class="col-xs-12">
                    {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': [{'id': 'details', 'label': 'mautic.core.details', 'content': projectTabContent, 'className': 'bdr-w-0 pa-16'}], 'part': 'content'}) }}
                </div>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}
