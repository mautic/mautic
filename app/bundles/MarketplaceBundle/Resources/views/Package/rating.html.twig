<div class="modal-body" id="marketplace-review-container"
     data-auth0-domain="{{ auth0Domain }}"
     data-auth0-client-id="{{ auth0ClientId }}"
     data-api-url="{{ reviewsApiUrl }}"
     data-package-name="{{ vendor }}/{{ package }}"
     data-submit-text="{{ 'marketplace.rating.submit'|trans }}">
    <!-- Loading state -->
    <div id="auth-loading" class="text-center p-lg">
        <i class="ri-loader-4-line ri-spin ri-2x"></i>
        <p>{% trans %}marketplace.rating.loading{% endtrans %}</p>
    </div>

    <!-- Login required -->
    <div id="auth-login" style="display: none;" class="text-center p-lg">
        <p class="mb-md">{% trans %}marketplace.rating.login.required{% endtrans %}</p>
        <button id="auth0-login-btn" class="btn btn-primary">
            <i class="ri-login-box-line mr-xs"></i>
            {% trans %}marketplace.rating.login.button{% endtrans %}
        </button>
    </div>

    <!-- Review form (shown when authenticated) -->
    <div id="auth-form" style="display: none;">
        <div id="auth-user-info" class="mb-md">
            <small class="text-muted">
                {% trans %}marketplace.rating.logged.as{% endtrans %}
                <strong id="auth-user-name"></strong>
                <a href="#" id="auth0-logout-btn" class="text-danger ml-sm">
                    {% trans %}marketplace.rating.logout{% endtrans %}
                </a>
            </small>
        </div>

        <div id="review-error" class="alert alert-danger" style="display: none;"></div>
        <div id="review-success" class="alert alert-success" style="display: none;"></div>

        <form id="review-form">
            <div class="form-group">
                <label>{% trans %}marketplace.rating.stars{% endtrans %}</label>
                <div class="rating-stars" id="rating-stars">
                    {% for i in 1..5 %}
                        <i class="ri-star-line ri-2x text-muted star-icon" data-rating="{{ i }}" style="cursor: pointer;"></i>
                    {% endfor %}
                </div>
                <input type="hidden" name="rating" id="rating" value="0">
            </div>

            <div class="form-group mt-md">
                <label for="review">{% trans %}marketplace.rating.review{% endtrans %}</label>
                <textarea
                    name="review"
                    id="review"
                    class="form-control"
                    rows="4"
                    placeholder="{{ 'marketplace.rating.review.placeholder'|trans }}"></textarea>
            </div>

            <div class="form-group mt-md">
                <button type="submit" id="submit-btn" class="btn btn-primary">
                    {% trans %}marketplace.rating.submit{% endtrans %}
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    Mautic.MarketplaceRating.init();
</script>
