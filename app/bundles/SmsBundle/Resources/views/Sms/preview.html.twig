{# sms @var \Mautic\SmsBundle\Entity\Sms #}
<div class="d-flex justify-content-center p-16">
    <div class="phone-preview animation--slide-in-right d-flex flex-column p-0 position-relative">
        <div class="phone-preview__silence-switch phone-preview__button--outer position-absolute"></div>
        <div class="phone-preview__volume-rocker--top phone-preview__button--outer position-absolute"></div>
        <div class="phone-preview__volume-rocker--bottom phone-preview__button--outer position-absolute"></div>
        <div class="phone-preview__power-button phone-preview__button--outer position-absolute"></div>

        <div class="phone-preview__top-section m-0">
            <div class="phone-preview__top-bar align-items-center d-flex justify-content-between">
                <div class="phone-preview__time">12:00</div>
                <div class="phone-preview__notch">
                    <div class="phone-preview__speaker">
                        <div class="phone-preview__front-camera"></div>
                    </div>
                </div>
                <div class="phone-preview__status-icons">
                    <i class="ri-signal-tower-line"></i>
                    <i class="ri-wifi-fill"></i>
                    <i class="ri-battery-fill"></i>
                </div>
            </div>
            <i class="phone-preview__back-arrow phone-preview__back-arrow--left d-inline-block position-absolute"></i>
            <div class="phone-preview__user-avatar align-items-center d-flex justify-content-center">
                <i class="ri-account-circle-fill"></i>
            </div>
            <div class="phone-preview__user-name align-items-center d-flex justify-content-center">{{ configGetParameter('brand_name') }}</div>
        </div>

        <div class="phone-preview__messages overflow-scroll">
            <div class="phone-preview__message phone-preview__message--from">
                <span class="phone-preview__message-content position-relative">{{ sms.getMessage() }}</span>
            </div>
            {% for image in sms.getMedia() %}
                <div class="phone-preview__message phone-preview__message--from phone-preview__message--media">
                    <span class="phone-preview__message-content position-relative"><img src="{{ image }}" alt="{{ 'mautic.sms.preview.input.placeholder'|trans }}"></span>
                </div>
            {% endfor %}
            <div class="phone-preview__message phone-preview__message--to">{{ 'mautic.sms.preview.demo.message'|trans }}</div>
        </div>

        <div class="phone-preview__keyboard">
            <div class="phone-preview__keyboard-input align-items-center d-flex position-relative">
                <div class="phone-preview__input-addon">
                    <i class="ri-camera-fill"></i>
                </div>
                <div class="phone-preview__cursor position-absolute">
                    <i class="ri-arrow-up-circle-fill phone-preview__send-button"></i>
                </div>
                <input type="text" class="phone-preview__input-field overflow-scroll w-100" placeholder="{{ 'mautic.sms.preview.input.placeholder'|trans }}" maxlength="1000"/>
            </div>

            <div class="phone-preview__keypad text-center user-select-none w-100">
                <div class="phone-preview__key-row d-flex justify-content-center">
                    {% for letter in ['Q','W','E','R','T','Y','U','I','O','P'] %}
                    <div class="phone-preview__key--white phone-preview__key--clickable d-inline-flex justify-content-center m-0 position-relative text-center">{{ letter }}</div>
                    {% endfor %}
                </div>
                <div class="phone-preview__key-spacer"></div>
                <div class="phone-preview__key-row d-flex justify-content-center">
                    {% for letter in ['A','S','D','F','G','H','J','K','L'] %}
                    <div class="phone-preview__key--white phone-preview__key--clickable d-inline-flex justify-content-center m-0 position-relative text-center">{{ letter }}</div>
                    {% endfor %}
                </div>
                <div class="phone-preview__key-spacer"></div>
                <div class="phone-preview__key-row d-flex justify-content-center">
                    <div class="phone-preview__key--white phone-preview__key--shift d-inline-flex justify-content-center m-0 position-relative text-center">&#8679;</div>
                    {% for letter in ['Z','X','C','V','B','N','M'] %}
                    <div class="phone-preview__key--white phone-preview__key--clickable d-inline-flex justify-content-center m-0 position-relative text-center">{{ letter }}</div>
                    {% endfor %}
                    <div class="phone-preview__key--grey phone-preview__key--backspace align-items-center d-inline-flex justify-content-center m-0 position-relative text-center">
                        <i class="ri-delete-back-2-fill"></i>
                    </div>
                </div>
                <div class="phone-preview__key-spacer"></div>
                <div class="phone-preview__key-row d-flex justify-content-center">
                    <div class="phone-preview__key--grey align-items-center d-inline-flex justify-content-center m-0 position-relative text-center">123</div>
                    <div class="phone-preview__key--grey phone-preview__key--emoji align-items-center d-inline-flex justify-content-center m-0 position-relative text-center">
                        <i class="ri-emoji-sticker-line"></i>
                    </div>
                    <div class="phone-preview__key--space d-inline-flex justify-content-center position-relative text-center">space</div>
                    <div class="phone-preview__key--grey phone-preview__key--return align-items-center d-inline-flex justify-content-center m-0 position-relative text-center">return</div>
                </div>
            </div>

            <div class="phone-preview__bottom-symbols d-flex justify-content-between">
                <i class="ri-global-fill phone-preview__symbol--globe"></i>
                <i class="ri-mic-fill phone-preview__symbol--mic"></i>
            </div>
            <div class="phone-preview__home-button"></div>
        </div>
    </div>
</div>
