{#
  Variables
    - tmpl
    - security
    - form
    - formThemes
    - formConfigs
    - isWritable
    - tabs
    - activeTab
#}
{% if formThemes is not empty and formThemes is iterable %}
  {% form_theme form with formThemes %}
{% elseif formThemes is not empty and formThemes is string %}
  {% form_theme form formThemes %}
{% endif %}

{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent %}config{% endblock %}

{% block headerTitle %}{{ 'mautic.config.header.index'|trans }}{% endblock %}

{% block content %}
<!-- start: box layout -->
<div class="container">
    <!-- step container -->
     <div class="row">
         <div class="col-md-3 height-auto">
             <div class="">
                 {% if not isWritable %}
                     <div class="alert alert-danger">{{ 'mautic.config.notwritable'|trans }}</div>
                 {% endif %}
                 <!-- Nav -->
                 <ul class="list-group list-group-tabs">
                     {% for key in tabs %}
                         {% set isActive = key == activeTab %}
                         {% set containsErrors = isActive and form[key] is defined and formContainsErrors(form[key]) %}
                         <li class="list-group-item {% if isActive %}in active{% endif %}">
                             <a href="{{ path('mautic_config_edit', {'activeTabId': key}) }}" data-toggle="ajax" {% if isActive %}aria-current="page"{% endif %} class="list-group-item-text steps {% if containsErrors %}text-danger{% endif %}">
                                 {{ ('mautic.config.tab.' ~ key)|trans }}
                                 {% if containsErrors %}
                                     <i class="ri-alert-line"></i>
                                 {% endif %}
                             </a>
                         </li>
                     {% endfor %}
                 </ul>
             </div>
         </div>

         <!-- container -->
         <div class="col-md-9 height-auto">
             {{ form_start(form) }}
             {% if activeTab and form[activeTab] is defined and formContainsErrors(form[activeTab]) %}
                 <div class="alert alert-danger">{{ 'mautic.config.form.has_errors'|trans }}</div>
             {% endif %}
             <div class="tab-content">
                 {% for key in form.children|keys|filter(v => formConfigs[v] is defined) %}
                     {% if form[key].children|length > 0 %}
                       <div class="tab-pane in active bdr-w-0" id="{{ key }}">
                           <div>
                            <div class="row pa-md bdr-b">
                                <h4 class="fw-sb">{{ ('mautic.config.tab.' ~ key)|trans }}</h4>
                            </div>
                               {{ form_widget(form[key], {'formConfig': formConfigs[key]}) }}
                           </div>
                       </div>
                     {% else %}
                       {% do form[key].setRendered() %}
                     {% endif %}
                 {% endfor %}
             </div>
             {{ form_end(form) }}
         </div>
     </div>
</div>
{% endblock %}
