{% if doNotContactFlag %}
  {% set dncConfig = {
    (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::UNSUBSCRIBED')): {
      icon: 'ri-error-warning-fill text-danger',
      label: 'mautic.lead.contact.status.unsubscribed'|trans,
      color: 'red',
      type: 'read-only'
    },
    (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::MANUAL')): {
      icon: 'ri-close-circle-fill text-danger',
      label: 'mautic.lead.contact.status.manual'|trans,
      color: 'red',
      type: 'dismissible'
    },
    (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::BOUNCED')): {
      icon: 'ri-alert-fill text-warning',
      label: 'mautic.lead.contact.status.bounced'|trans,
      color: 'yellow',
      type: 'dismissible'
    }
  } %}
  
  {% set config = dncConfig[doNotContactFlag.reason] %}
  {% if config is defined %}
    <div class="contact-status__label mb-xs" id="bounceLabel{{ doNotContactFlag.id }}">
      <i class="contact-status__icon {{ config.icon }}"></i>
      <span class="contact-status__text fw-sb">{{ channelLabel|trans }}</span>
      {% include '@MauticCore/Helper/_tag.html.twig' with {'tags': 
        [{
          label: config.label,
          type: config.type,
          color: config.color,
          size: 'sm',
          dismissible_onclick: config.type == 'dismissible' ? "Mautic.removeBounceStatus(this, " ~ doNotContactFlag.id ~ ", '" ~ doNotContactFlag.channel ~ "');" : null,
          attributes: {class: 'ml-xs'}
        }]
      } %}
    </div>
  {% endif %}
{% else %}
  <div class="contact-status__label mb-xs">
    <i class="contact-status__icon ri-checkbox-circle-fill text-success"></i>
    <span class="contact-status__text fw-sb">{{ channelLabel|trans }}</span>
  </div>
{% endif %}