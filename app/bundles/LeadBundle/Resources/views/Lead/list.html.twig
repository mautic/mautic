{#
  Variables
    - items
#}
{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent %}lead{% endblock %}
{% block headerTitle %}{{ 'mautic.lead.leads'|trans }}{% endblock %}

{% block content %}
  <div class="p-16" data-search-demo>
    {% include '@MauticCore/Components/search-input.html.twig' with {id: 'search-demo-default', name: 'search-demo-default', labelText: 'Search contacts', placeholder: 'Search contacts'} only %}
    {% include '@MauticCore/Components/search-input.html.twig' with {variant: 'fluid', id: 'search-demo-fluid', name: 'search-demo-fluid', labelText: 'Search contacts (fluid)', placeholder: 'Search contacts'} only %}
  </div>
  {{ include('@MauticLead/Lead/_filter.html.twig') }}
  {{ include('@MauticLead/Lead/_list.html.twig') }}

  {% if isIndex %}
        </div>
    </div>
    {{ include('@MauticCore/Modules/protip.html.twig', {
      tip: random(['mautic.protip.contacts.view', 'mautic.protip.contacts.tags', 'mautic.protip.contacts.list'])
  }) }}
  {% endif %}
{% endblock %}
