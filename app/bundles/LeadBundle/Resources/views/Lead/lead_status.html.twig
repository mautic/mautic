{% set leadStatusesPopoverContent %}

{% set leadStatusesHelp = {
'Unsubscribed': 'This contact chose to stop receiving any marketing communication by using a link for general
unsubscribe.',
'Manually unsubscribed': 'A user manually set this contact as DNC by editing them, or using campaign events, form
actions or via integration.',
'Bounced': 'The system encountered an error when trying to deliver a message to this contact.',
'Subscribed': 'This contact is contactable using'
} %}

{% for status, description in leadStatusesHelp %}
<div class="type-heading-01">{{ status }}</div>
<div class="mb-lg">{{ description }}</div>
{% endfor %}

Note: Transactional messages, such as the ones sent by forms or using campaign action configured to transactional, are
not affected by the DNC flag and bypass these statuses.

{% endset %}


<div class="pa-md">
    <div class="contact-status" data-toggle="popover" data-content="{{ leadStatusesPopoverContent|escape }}"
        data-html="true" data-title="Understand different statuses" data-container="body" data-placement="left"
        tabindex="0">
        {% if not doNotContactSms %}
        {% if doNotContact %}
        {% set statusConfig = {
        (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::UNSUBSCRIBED')): {
        'class': 'text-danger',
        'icon': 'ri-error-warning-fill',
        'label': 'Unsubscribed'
        },
        (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::MANUAL')): {
        'class': 'text-danger',
        'icon': 'ri-close-circle-fill',
        'label': 'Manually unsubscribed'
        },
        (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::BOUNCED')): {
        'class': 'text-warning',
        'icon': 'ri-alert-fill',
        'label': 'Bounced'
        }
        } %}

        {% set config = statusConfig[doNotContact.reason] %}
        <div class="contact-status__heading {{ config.class }}">
            <i class="contact-status__icon {{ config.icon }}"></i>
            <span class="contact-status__text fw-sb">{{ config.label }}</span>
        </div>
        {% else %}
        <div class="contact-status__heading text-success">
            <i class="contact-status__icon ri-checkbox-circle-fill"></i>
            <span class="contact-status__text fw-sb">Subscribed</span>
        </div>
        {% endif %}
        {% else %}
        <div class="contact-status__heading contact-status__heading--expanded">
            <span class="contact-status__text fw-sb text-secondary">Custom preferences</span>
        </div>
        <div class="contact-status__divider"></div>

        <div class="contact-status__channels d-flex fd-column mb-xs">
            {{ include('@MauticLead/Lead/_dnc_large.html.twig', {'doNotContactFlag': doNotContact, 'channelLabel':
            'Email'}) }}
            {{ include('@MauticLead/Lead/_dnc_large.html.twig', {'doNotContactFlag': doNotContactSms, 'channelLabel':
            'SMS'}) }}
        </div>

        {% endif %}
    </div>
</div>