{% if doNotContactFlag %}
  {% set dncConfig = {
    (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::UNSUBSCRIBED')): {
      icon: 'ri-error-warning-fill text-danger',
      label: 'Unsubscribed',
      color: 'red',
      type: 'read-only'
    },
    (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::MANUAL')): {
      icon: 'ri-close-circle-fill text-danger',
      label: 'Manually unsubscribed',
      color: 'red',
      type: 'dismissible'
    },
    (constant('\\Mautic\\LeadBundle\\Entity\\DoNotContact::BOUNCED')): {
      icon: 'ri-alert-fill text-warning',
      label: 'Bounced',
      color: 'yellow',
      type: 'dismissible'
    }
  } %}
  
  {% set config = dncConfig[doNotContactFlag.reason] %}
  {% if config is defined %}
    <div class="contact-status__label mb-xs">
      <i class="contact-status__icon {{ config.icon }}"></i>
      <span class="contact-status__text fw-sb">{{ channelLabel }}</span>
      {% include '@MauticCore/Components/tag.html.twig' with {'tags': 
        [{
          label: config.label,
          type: config.type,
          color: config.color,
          size: 'sm',
          onClick: config.type == 'dismissible' ? "Mautic.removeBounceStatus(this, " ~ doNotContactFlag.id ~ ", '" ~ doNotContactFlag.channel ~ "');" : null,
          dismissTooltip: config.type == 'dismissible' ? 'mautic.lead.remove_dnc_status' : null,
          className: config.type == 'dismissible' ? 'ml-xs' : null
        }]
      } %}
    </div>
  {% endif %}
{% else %}
  <div class="contact-status__label mb-xs">
    <i class="contact-status__icon ri-checkbox-circle-fill text-success"></i>
    <span class="contact-status__text fw-sb">{{ channelLabel }}</span>
  </div>
{% endif %}