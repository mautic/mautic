{#
  Variables
    - form
    - groups
    - fields
#}
{% set halfSize = embedded is defined ? 6 : 4 %}
{% set fullSize = embedded is defined ? 12 : 8 %}
<!-- pane -->
{% for key, group in groups %}
    {% if fields[group] is defined %}
        {% set groupFields = fields[group] %}
        {% if groupFields is not empty %}
            <div class="tab-pane fade {% if loop.first %}in active{% endif %} rounded-0 bdr-w-0" id="company-{{ group }}">
                {% if embedded is not defined %}
                    <div class="pa-16 bdr-b">
                        <h4 class="fw-sb">{{ ('mautic.lead.field.group.'~group)|trans }}</h4>
                    </div>
                {% endif %}
                {{ include('@MauticLead/Company/_form_group_fields.html.twig', {
                    'form': form,
                    'group': group,
                    'groupFields': groupFields,
                    'halfSize': halfSize,
                    'fullSize': fullSize,
                    'embedded': embedded is defined,
                }) }}
            </div>
        {% endif %}
    {% endif %}
{% endfor %}
