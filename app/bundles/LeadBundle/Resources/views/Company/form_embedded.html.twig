{#
  Variables
    - form
    - groups
    - fields
#}
{{ form_start(form) }}
    {% set companyTabs = [] %}
    {% for g in groups %}
        {% if fields[g] is not empty %}
            {% set groupContent %}
                {{ include('@MauticLead/Company/_form_group_fields.html.twig', {
                    'form': form,
                    'group': g,
                    'groupFields': fields[g],
                    'halfSize': 6,
                    'fullSize': 12,
                    'embedded': true,
                }) }}
            {% endset %}
            {% set companyTabs = companyTabs|merge([{
                'id': 'company-' ~ g,
                'label': 'mautic.lead.field.group.' ~ g,
                'content': groupContent,
            }]) %}
        {% endif %}
    {% endfor %}
    {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': companyTabs, 'variant': 'contained'}) }}
{{ form_end(form) }}
