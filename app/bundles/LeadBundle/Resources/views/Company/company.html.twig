{#
  Variables
    - company
    - fields
    - items
    - permissions
    - engagementData
    - security
    - page
    - totalItems
    - limit
#}
{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}company{% endblock %}


{% block headerTitle %}{{ company.name }}{% endblock %}

{% block preHeader %}
{{- include('@MauticCore/Helper/page_actions.html.twig',
    {
        'item'            : company,
        'routeBase'       : 'company',
        'langVar'         : 'company',
        'customButtons'   : [],
        'templateButtons' : {
            'close' : securityHasEntityAccess(permissions['lead:leads:viewown'], permissions['lead:leads:viewother'], company.permissionUser),
        },
        'targetLabel'     : 'mautic.lead.lead.companies'|trans
    }
) -}}
{{ include('@MauticProject/Modules/projects.html.twig', {'item': company}) }}
{% endblock %}

{% block actions %}
{% set canEdit     = securityHasEntityAccess(permissions['lead:leads:editown'], permissions['lead:leads:editother'], company.permissionUser) %}
{% set canMerge    = securityHasEntityAccess(permissions['lead:leads:deleteown'], permissions['lead:leads:deleteother'], company.permissionUser) %}
{% set canDownload = securityHasEntityAccess(permissions['lead:leads:viewown'], permissions['lead:leads:viewother'], company.permissionUser) %}
{% set buttons     = [] %}

{% if canMerge and canEdit %}
    {% set buttons = buttons|merge([{
        'attr': {
            'data-toggle': 'ajaxmodal',
            'data-target': '#MauticSharedModal',
            'data-header': 'mautic.lead.company.header.merge'|trans({'%name%': company.primaryIdentifier}),
            'href': path('mautic_company_action', {'objectId': company.id, 'objectAction': 'merge'}),
        },
        'btnText': 'mautic.lead.merge'|trans,
        'iconClass': 'ri-exchange-2-line',
    }]) %}
{% endif %}

{% if canDownload %}
    {% set buttons = buttons|merge([{
        'attr': {
            'data-toggle': 'download',
            'href': path('mautic_company_export_action', {'companyId': company.id}),
        },
        'btnText': 'mautic.core.export'|trans,
        'iconClass': 'ri-export-line',
    }]) %}
{% endif %}

  {{ include('@MauticCore/Helper/page_actions.html.twig', {
        'item': company,
        'routeBase': 'company',
        'langVar': 'company',
        'customButtons': buttons,
        'templateButtons': {
            'edit': canEdit,
            'delete': securityHasEntityAccess(permissions['lead:leads:deleteown'], permissions['lead:leads:deleteother'], company.permissionUser),
        },
  }) }}
{% endblock %}

{% block content %}
<!-- start: box layout -->
<div class="box-layout">
    <!-- left section -->
    <div class="col-md-9 height-auto">
        <div>
            <!--/ lead detail header -->

            <!-- lead detail collapseable -->
            <div class="collapse pe-16 ps-16" id="lead-details">
                {% set companyTabs = [] %}
                {% for g in fields|keys %}
                    {% if fields[g] is not empty %}
                        {% set companyTabContent %}
                        {% set group = g %}
                                <div class="pe-16 ps-16 pb-16">
                                    <div class="panel shd-none mb-0">
                                        <table class="table table-hover mb-0">
                                            <tbody>
                                            {% for field in fields[group] %}
                                                {% if field.value is not empty %}
                                                    <tr>
                                                        <td width="20%"><span class="fw-b">{{ field.label }}</span></td>
                                                        <td>
                                                            {% if 'core' == group and 'country' == field.alias and flag is defined %}
                                                              <img class="me-12" src="{{ flag }}" alt="" style="max-height: 24px;"/>
                                                              <span class="mt-1">{{ field.value }}</span>
                                                            {% else %}
                                                              {% if field.value is iterable and 'multiselect' == field.type %}
                                                                  {{ field.value|join(', ') }}
                                                              {% elseif 'url' == field.type %}
                                                                  <a href="{{ field.value }}" target="_blank">{{ field.value }}</a>
                                                              {% else %}
                                                                  {{ field.normalizedValue }}
                                                              {% endif %}
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endif %}
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                        {% endset %}
                        {% set companyTabs = companyTabs|merge([{'id': g, 'label': ('mautic.lead.field.group.' ~ g)|trans, 'content': companyTabContent, 'className': 'pa-16'}]) %}
                    {% endif %}
                {% endfor %}
                {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': companyTabs, 'variant': 'contained'}) }}
            </div>
            <!--/ lead detail collapseable -->
        </div>

        <div>
            <!-- lead detail collapseable toggler -->
            <div class="hr-expand nm">
                <span data-bs-toggle="tooltip" title="{{ 'mautic.core.details'|trans }}">
                    <a href="javascript:void(0)" class="arrow text-secondary collapsed" data-bs-toggle="collapse" data-bs-target="#lead-details">
                       <span class="caret"></span>
                       {{ 'mautic.core.details'|trans }}
                    </a>
                </span>
            </div>
            <!--/ lead detail collapseable toggler -->
        </div>

        {{ customContent('company.engagement.before', _context) }}
        <div class="pa-16 enage">
            <div class="row">
                <div class="col-sm-12">
                    <div class="panel">
                        <div class="panel-body box-layout">
                            <div class="col-xs-8 align-middle">
                                <h5 class="text-white dark-md fw-sb mb-5">
                                    {{ 'mautic.lead.field.header.engagements'|trans }}
                                </h5>
                            </div>
                            <div class="col-xs-4 align-top text-end">
                                <h3 class="text-white dark-sm"><span class="ri-eye-line"></span></h3>
                            </div>
                        </div>
                        <div id="company_contact_engagement" data-target-url="{{ path('mautic_company_graph', {'objectId': company.id}) }}">
                            <div class="spinner"><i class="fa fa-spin fa-spinner"></i></div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{ customContent('company.engagement.after', _context) }}
        <!-- contacts section -->
        {% set contactsTable %}
            <div class="row">
                <div class="col-sm-12">
                    <div id="contacts-table" data-target-url="{{ path('mautic_company_contacts_list', {'objectId': company.id}) }}">
                        <div class="spinner"><i class="fa fa-spin fa-spinner"></i></div>
                        <div class="clearfix"></div>
                    </div>
                </div>
            </div>
        {% endset %}
        {% set customTabs %}{{ customContent('company.tabs', _context) }}{% endset %}
        {% if customTabs is empty %}
            <div class="pa-16 enage">
                {{ contactsTable }}
            </div>
        {% else %}
            <div class="pa-16">
                <ul class="nav nav-tabs nav-tabs-contained">
                    <li class="active">
                        <a href="#company-contacts-container" class="nav-link active" role="tab" data-bs-toggle="tab">
                            {{ 'mautic.lead.leads'|trans }}
                        </a>
                    </li>
                    {{ customTabs }}
                </ul>
                <div class="tab-content pa-16">
                    <div class="tab-pane fade show active bdr-w-0" id="company-contacts-container">
                        {{ contactsTable }}
                    </div>
                    {{ customContent('company.tabs.content', _context) }}
                </div>
            </div>
        {% endif %}
        <!--/ contacts section -->
        {{ customContent('company.contacts.after', _context) }}

        <!--/ end: tab-content -->
    </div>

    <!--/ left section -->

    <!-- right section -->
    <div class="col-md-3 bdr-l height-auto">
        {{ customContent('company.sidebar.top', _context) }}
        <!-- form HTML -->
        <div class="panel shd-none rounded-0 bdr-w-0 mb-0">
            <div class="mt-12 points-panel text-center">
                <h1>{{ 'mautic.company.score.count'|trans({'%count%': company.score}) }}</h1>
                <hr/>
            </div>
            <div class="panel-heading">
                <div class="panel-title">{{ 'mautic.lead.field.group.company'|trans }}</div>
            </div>
            <div class="panel-body pt-12">
                {% if company.owner %}
                  <h6 class="fw-sb">{{ 'mautic.lead.company.field.owner'|trans }}</h6>
                  <p class="text-secondary">{{ company.owner.name }}</p>
                {% endif %}

                <h6 class="fw-sb">{{ 'mautic.lead.field.address'|trans }}</h6>
                <address class="text-secondary">
                    {% if company.address1 is not empty %}
                        {{ company.address1 }}<br>
                    {% endif %}
                    {% if company.address2 is not empty %}
                        {{ company.address2 }}<br>
                    {% endif %}
                    {{ company.city }} {{ company.zipcode }}
                    <br>
                </address>

                <h6 class="fw-sb">{{ 'mautic.core.type.email'|trans }}</h6>
                <p class="text-secondary">{{ company.email }}</p>

                {% if company.phone is not empty %}
                  <h6 class="fw-sb">{{ 'mautic.company.phone'|trans }}</h6>
                  <p class="text-secondary">{{ company.phone }}</p>
                {% endif %}
            </div>
        </div>
        <!--/ form HTML -->
        {{ customContent('company.sidebar.bottom', _context) }}
    </div>
    <!--/ right section -->
</div>
<!--/ end: box layout -->
{% endblock %}
