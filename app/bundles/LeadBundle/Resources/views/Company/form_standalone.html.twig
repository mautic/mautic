{#
  Variables
    - entity
    - form
    - groups
    - fields
#}
{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}company{% endblock %}

{% block headerTitle %}
  {%- if entity.id -%}
    {{- 'mautic.company.menu.edit'|trans({'%name%': entity.name|purify}) -}}
  {%- else -%}
    {{- 'mautic.company.menu.new'|trans -}}
  {%- endif -%}
{% endblock %}

{% block actions %}
  {{ include('@MauticCore/Helper/page_actions.html.twig', {'item': entity, 'routeBase': 'company', 'langVar': 'lead.company'}) }}
{% endblock %}

{% block content %}
{{ form_start(form) }}
    {% set companyTabs = [] %}
    {% for g in groups %}
        {% if fields[g] is not empty %}
            {% set groupContent %}
                <div class="pa-16 bdr-b">
                    <h4 class="fw-sb">{{ ('mautic.lead.field.group.'~g)|trans }}</h4>
                </div>
                {{ include('@MauticLead/Company/_form_group_fields.html.twig', {
                    'form': form,
                    'group': g,
                    'groupFields': fields[g],
                    'halfSize': 4,
                    'fullSize': 8,
                    'embedded': false,
                }) }}
            {% endset %}
            {% set companyTabs = companyTabs|merge([{
                'id': 'company-' ~ g,
                'label': 'mautic.lead.field.group.' ~ g,
                'content': groupContent,
                'className': 'rounded-0 bdr-w-0'
            }]) %}
        {% endif %}
    {% endfor %}
    {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': companyTabs, 'variant': 'vertical'}) }}
{{ form_end(form) }}
{% endblock %}
