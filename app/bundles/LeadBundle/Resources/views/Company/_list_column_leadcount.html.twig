<td class="visible-md visible-lg">
    {% set contactCount = leadCounts[item.id]|default(0) %}
    {% include '@MauticCore/Helper/_tag.html.twig' with {
        tags: [{
            label: 'mautic.lead.company.viewleads_count'|trans({'%count%': contactCount}),
            color: 'gray',
            size: 'sm',
            attributes: {
                id: 'company-leads-count-' ~ item.id,
                href: path('mautic_contact_index', {'search': 'mautic.lead.lead.searchcommand.company_id'|trans ~ ':' ~ item.id}),
                'data-toggle': 'ajax'
            }|filter((v, k) => 0 != (contactCount) or (k != 'href' and k != 'data-toggle'))
        }]
    } %}
</td>
