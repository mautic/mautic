{# segment_date_filter_widget.html.twig #}
<div>
    {% set dateTypeMode = form.children.dateTypeMode %}
    {{ form_row(dateTypeMode) }}
    <div{{ 'absolute' != dateTypeMode.vars.value ? ' class="absolute-date hide"' : ' class="absolute-date"' }}>
        {{ form_row(form.children.absoluteDate) }}
    </div>

    <div{{ 'relative' != dateTypeMode.vars.value ? ' class="relative-date hide"' : ' class="relative-date"' }}>
        <div class="row">
            <div class="col-sm-4">
                {{ form_row(form.children.relativeDateInterval) }}
            </div>
            <div class="col-sm-8">
                {{ form_row(form.children.relativeDateIntervalUnit) }}
            </div>
        </div>
    </div>
</div>
