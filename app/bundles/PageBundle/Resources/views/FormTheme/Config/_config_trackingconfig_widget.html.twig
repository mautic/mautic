{% block _config_trackingconfig_widget %}
<h4 class="fw-sb mt-48 mb-xs">{{ 'mautic.config.tab.pagetracking'|trans }}</h4>
<div class="text-muted small pb-md">{{ 'mautic.core.config.header.pagetracking.description'|trans }}</div>
<div class="row">
    <div class="panel panel-default mb-md">
        <div class="panel-body">
            <div class="form-group">
                <p>{{ 'mautic.config.tab.pagetracking.info'|trans|purify }}</p>
                <ul class="nav nav-tabs nav-tabs-contained">
                    <li class="active">
                        <a href="#tracking-snippet-consent" role="tab" data-toggle="tab">
                            {{ 'mautic.page.config.tracking.script.consent.tab'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="#tracking-snippet-full" role="tab" data-toggle="tab">
                            {{ 'mautic.page.config.tracking.script.full.tab'|trans }}
                        </a>
                    </li>
                </ul>
                <div class="tab-content pa-md">
                    <div class="tab-pane bdr-w-0 active in" id="tracking-snippet-consent">
                        <p class="text-muted small">{{ 'mautic.page.config.tracking.script.consent.description'|trans }}</p>
                        <div class="alert alert-info" role="alert">
                            {{ 'mautic.page.config.tracking.script.consent.focus_notice'|trans }}
                        </div>
                        <h5 class="fw-sb mb-xs">{{ 'mautic.page.config.tracking.script.essential.label'|trans }}</h5>
                        <p class="text-muted small">{{ 'mautic.page.config.tracking.script.essential.description'|trans }}</p>
                        {% include '@MauticCore/Components/code-snippet.html.twig' with {
                            variant: 'multi',
                            ariaLabel: 'mautic.page.config.tracking.script.essential.label'|trans,
                            innerText: '&lt;script&gt;
    (function(w,d,t,u,a,m){
        if (d.getElementById(\'mautic-essential-script\')) return;
        a=d.createElement(t),m=d.getElementsByTagName(t)[0];
        a.id=\'mautic-essential-script\';a.async=1;a.src=u;
        a.onload=function(){
            if (w.MauticJS && w.MauticJS.runtimeReady === true) {
                w.MauticJS.dispatchEvent(\'mauticEssentialReady\')
            }
        };m.parentNode.insertBefore(a,m)
    })(window,document,\'script\',\'' ~ url('mautic_essential_js') ~ '\');
&lt;/script&gt;',
                        } %}
                        <h5 class="fw-sb mt-lg mb-xs">{{ 'mautic.page.config.tracking.script.tracking.label'|trans }}</h5>
                        <p class="text-muted small">{{ 'mautic.page.config.tracking.script.tracking.description'|trans }}</p>
                        {% include '@MauticCore/Components/code-snippet.html.twig' with {
                            variant: 'multi',
                            ariaLabel: 'mautic.page.config.tracking.script.tracking.label'|trans,
                            innerText: '&lt;script&gt;
    (function(w,d,t,u,n,a,m){
        function enableTracking(){
            if (!w.MauticJS || w.MauticJS.runtimeReady !== true) return;
            d.removeEventListener(\'mauticEssentialReady\',enableTracking);
            if (w.MauticJS.trackingEnabled === true || d.getElementById(\'mautic-tracking-script\')) return;
            w[\'MauticTrackingObject\']=n;
            w[n]=w[n]||function(){(w[n].q=w[n].q||[]).push(arguments)};
            w[n](\'send\',\'pageview\');
            a=d.createElement(t),m=d.getElementsByTagName(t)[0];
            a.id=\'mautic-tracking-script\';a.async=1;a.src=u;m.parentNode.insertBefore(a,m)
        }
        if (w.MauticJS && w.MauticJS.runtimeReady === true) {
            enableTracking()
        } else {
            d.addEventListener(\'mauticEssentialReady\',enableTracking)
        }
    })(window,document,\'script\',\'' ~ url('mautic_tracking_js') ~ '\',\'mt\');
&lt;/script&gt;',
                        } %}
                    </div>
                    <div class="tab-pane bdr-w-0" id="tracking-snippet-full">
                        <p class="text-muted small">{{ 'mautic.page.config.tracking.script.full.description'|trans }}</p>
                        {% include '@MauticCore/Components/code-snippet.html.twig' with {
                            variant: 'multi',
                            ariaLabel: 'mautic.page.config.tracking.script.full.tab'|trans,
                            innerText: '&lt;script&gt;
    (function(w,d,t,e,r,n,a,m,s){w[\'MauticTrackingObject\']=n;
        w[n]=w[n]||function(){(w[n].q=w[n].q||[]).push(arguments)},a=d.createElement(t),
        m=d.getElementsByTagName(t)[0];a.async=1;a.src=e;
        a.onload=function(){s=d.createElement(t);s.async=1;s.src=r;
            m.parentNode.insertBefore(s,m)
        };m.parentNode.insertBefore(a,m)
    })(window,document,\'script\',\'' ~ url('mautic_essential_js') ~ '\',\'' ~ url('mautic_tracking_js') ~ '\',\'mt\');
    mt(\'send\', \'pageview\');
&lt;/script&gt;',
                        } %}
                    </div>
                </div>
            </div>
            <div class="row">
                <hr>
                {% for name, f in form.children %}
                    {% if name in ['anonymize_ip', 'track_contact_by_ip', 'do_not_track_404_anonymous', 'append_segment_id_tracking_url'] %}
                        <div class="col-xs-12">
                            {{ form_row(f) }}
                            {% if name == 'anonymize_ip' %}
                                <div class="anonymize_ip_address hide text-danger">{{ 'mautic.page.config.form.anonymize_ip.warning'|trans }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<h4 class="fw-sb mt-48 mb-xs">{{ 'mautic.config.tab.tracking.facebook.pixel'|trans }}</h4>
<div class="text-muted small pb-md">{{ 'mautic.core.config.header.tracking.facebook.pixel.description'|trans }}</div>
<div class="row">
    <div class="panel panel-default mb-md">
        <div class="panel-body">
            <div class="row">
                <div class="col-xs-12">
                    {{ formRowIfExists(form, 'facebook_pixel_id') }}
                </div>
                <hr>
                {% for name, f in form.children %}
                    {% if name in ['facebook_pixel_trackingpage_enabled', 'facebook_pixel_landingpage_enabled'] %}
                        <div class="col-xs-12">
                            {{ form_row(f) }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<h4 class="fw-sb mt-48 mb-xs">{{ 'mautic.config.tab.tracking.google.analytics'|trans }}</h4>
<div class="text-muted small pb-md">{{ 'mautic.core.config.header.tracking.google.analytics.description'|trans }}</div>
<div class="row">
    <div class="panel panel-default mb-md">
        <div class="panel-body">
            <div class="row">
                <div class="col-xs-12">
                    {{ formRowIfExists(form, 'google_analytics_id') }}
                </div>
                <hr>
                {% for name, f in form.children %}
                    {% if name in ['google_analytics_trackingpage_enabled', 'google_analytics_landingpage_enabled', 'google_analytics_anonymize_ip'] %}
                        <div class="col-xs-12">
                            {{ form_row(f) }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
