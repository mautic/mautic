{%- set isIndex = 'index' == tmpl -%}
{%- set tmpl = 'list' -%}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent 'report' %}

{% block headerTitle 'mautic.report.reports'|trans %}

{% block content %}
  {% if isIndex %}
  <div id="page-list-wrapper" class="panel panel-default">
    {{ include('@MauticCore/Helper/list_toolbar.html.twig', {
      'searchValue': searchValue,
      'searchScopes': searchScopes|default([]),
      'searchScopeHint': searchScopeHint|default(null),
      'action': currentRoute,
      'page_actions': {
          'templateButtons': {
              'new': permissions['report:reports:create'],
          },
          'routeBase': 'report',
          'langVar': 'report.report',
      },
      'bulk_actions': {
        'langVar': 'report.report',
        'routeBase': 'report',
        'templateButtons': {
            'delete': permissions['report:reports:deleteown'] or permissions['report:reports:deleteother'],
        },
      },
      'quickFilters': {
            'mautic.core.quick_filters.status': {
                'conflictGroup': true,
                'filters': [
                    {
                        'search': 'mautic.core.searchcommand.ispublished',
                        'label': 'mautic.core.form.available',
                        'tooltip': 'mautic.core.searchcommand.ispublished.description',
                        'icon': 'ri-check-line'
                    },
                    {
                        'search': 'mautic.core.searchcommand.isunpublished',
                        'label': 'mautic.core.form.unavailable',
                        'tooltip': 'mautic.core.searchcommand.isunpublished.description',
                        'icon': 'ri-close-line'
                    }
                ]
            },
            'mautic.core.quick_filters.ownership': {
                'conflictGroup': true,
                'filters': [
                    {
                        'search': 'mautic.core.searchcommand.ismine',
                        'label': 'mautic.core.searchcommand.ismine.label',
                        'tooltip': 'mautic.core.searchcommand.ismine.description',
                        'icon': 'ri-user-line'
                    }
                ]
            },
            'mautic.core.quick_filters.others': {
                'filters': [
                    {
                        'search': 'mautic.report.report.searchcommand.isscheduled',
                        'label': 'mautic.report.report.searchcommand.isscheduled.label',
                        'tooltip': 'mautic.report.report.searchcommand.isscheduled.description',
                        'icon': 'ri-calendar-schedule-line'
                    }
                ]
            },
            'mautic.report.quick_filters.datasource': {
                'conflictGroup': true,
                'filters': [
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':leads',
                        'label': 'mautic.report.quickfilter.source.contacts.label',
                        'tooltip': 'mautic.report.quickfilter.source.contacts.tooltip',
                        'icon': 'ri-group-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':campaign_lead_event_log',
                        'label': 'mautic.report.quickfilter.source.campaigns.label',
                        'tooltip': 'mautic.report.quickfilter.source.campaigns.tooltip',
                        'icon': 'ri-flag-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':assets',
                        'label': 'mautic.report.quickfilter.source.assets.label',
                        'tooltip': 'mautic.report.quickfilter.source.assets.tooltip',
                        'icon': 'ri-folder-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':emails',
                        'label': 'mautic.report.quickfilter.source.emails.label',
                        'tooltip': 'mautic.report.quickfilter.source.emails.tooltip',
                        'icon': 'ri-mail-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':forms',
                        'label': 'mautic.report.quickfilter.source.forms.label',
                        'tooltip': 'mautic.report.quickfilter.source.forms.tooltip',
                        'icon': 'ri-clipboard-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':segment.log',
                        'label': 'mautic.report.quickfilter.source.segment_log.label',
                        'tooltip': 'mautic.report.quickfilter.source.segment_log.tooltip',
                        'icon': 'ri-team-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':contact.dnc',
                        'label': 'mautic.report.quickfilter.source.contact_dnc.label',
                        'tooltip': 'mautic.report.quickfilter.source.contact_dnc.tooltip',
                        'icon': 'ri-forbid-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':pages',
                        'label': 'mautic.report.quickfilter.source.pages.label',
                        'tooltip': 'mautic.report.quickfilter.source.pages.tooltip',
                        'icon': 'ri-window-line'
                    },
                    {
                        'search': ('mautic.report.report.searchcommand.source'|trans) ~ ':focus_stats',
                        'label': 'mautic.report.quickfilter.source.focus_stats.label',
                        'tooltip': 'mautic.report.quickfilter.source.focus_stats.tooltip',
                        'icon': 'ri-focus-3-line'
                    }
                ]
            }
      },
  }) }}
      <div class="page-list">
        {{- include('@MauticReport/Report/_list.html.twig') -}}
      </div>
  </div>

  {{ include('@MauticCore/Modules/protip.html.twig', {
    tip: random(['mautic.protip.reports.dnc'])
}) }}
  {% else %}
    {{- include('@MauticReport/Report/_list.html.twig') -}}
  {% endif %}
{% endblock %}
