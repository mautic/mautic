{#
    This field relies on the `group.html.twig` implementation.
#}
{% set yesLabel = field.properties.yes|default('mautic.core.form.yes'|trans) %}
{% set noLabel = field.properties.no|default('mautic.core.form.no'|trans) %}
{% set list = {} %}

{% if noLabel is not empty %}
    {% set list = list|merge({'0': noLabel}) %}
{% endif %}

{% if yesLabel is not empty %}
    {% set list = list|merge({'1': yesLabel}) %}
{% endif %}

{# Force the isBooleanList flag to true for boolean fields #}
{% set isBooleanList = true %}

{{- include([theme|default('') ~ 'group.html.twig', '@MauticForm/Field/group.html.twig'], {
        'field': field,
        'fields': fields|default([]),
        'inForm': inForm|default(false),
        'id': id,
        'formId': formId|default(0),
        'formName': formName|default(''),
        'type': 'radio',
        'list': list,
        'isBooleanList': isBooleanList,
        'mappedFields': mappedFields|default([]),
}) -}}
