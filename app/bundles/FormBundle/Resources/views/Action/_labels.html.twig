{% set footerContent %}

    {# Add to points #}
    {% if action.properties.score is defined %}
        <span class="label
            {% if action.properties.score < 0 %}
                label-red
            {% elseif action.properties.score == 0 %}
                label-warm-gray
            {% else %}
                label-green
            {% endif %}">
            {{ 'mautic.form.form.change_points_by'|trans({'%value%': action.properties.score}) }}
        </span>
    {% endif %}

    {# Reply to contact #}
    {% if action.properties.set_replyto is defined and action.properties.set_replyto == 1 %}
        <span class="label label-green">
            {{ 'mautic.form.form.reply_to_contact'|trans }}
        </span>
    {% endif %}

    {# Send to owner #}
    {% if action.properties.email_to_owner is defined and action.properties.email_to_owner == 1 %}
        <span class="label label-green">
            {{ 'mautic.form.form.send_to_owner'|trans }}
        </span>
    {% endif %}

    {# Send to contact #}
    {% if action.properties.copy_lead is defined and action.properties.copy_lead == 1 %}
        <span class="label label-green">
            {{ 'mautic.form.form.send_to_contact'|trans }}
        </span>
    {% endif %}

    {# Email to send to contact #}
    {% if action.properties.email is defined %}
        <a href="{{ path('mautic_email_action', {'objectAction' : 'view', 'objectId' : action.properties.email }) }}" class="label label-gray" size="sm">{{ 'mautic.email.email'|trans }} ({{ action.properties.email }})</a>
    {% endif %}

    {# Email to send to user #}
    {% if action.properties.useremail is defined and action.properties.useremail.email is defined %}
        <a href="{{ path('mautic_email_action', {'objectAction' : 'view', 'objectId' : action.properties.useremail.email }) }}" class="label label-gray" size="sm">
            {{ 'mautic.email.email'|trans }} ({{ action.properties.useremail.email }})
        </a>
    {% endif %}

    {# Send email to users #}
    {% if action.properties.user_id is defined and action.properties.user_id is not empty %}
        {% for userId in action.properties.user_id %}
            {% if securityIsGranted('user:users:edit') %}
                <a href="{{ path('mautic_user_action', {'objectAction': 'edit', 'objectId': userId }) }}" class="label label-gray" size="sm">
                    {{ 'mautic.user.user.form.user'|trans }} ({{ userId }})
                </a>
            {% else %}
                <span class="label label-default">
                    {{ 'mautic.user.user.form.user'|trans }} ({{ userId }})
                </span>
            {% endif %}
        {% endfor %}
    {% endif %}


    {# Add to lists #}
    {% if action.properties.addToLists is defined and action.properties.addToLists is not empty %}
        {% for listId in action.properties.addToLists %}
            <span class="label label-green">
                <i class="ri-pie-chart-line"></i> {{ listId }}
            </span>
        {% endfor %}
    {% endif %}

    {# Remove from lists #}
    {% if action.properties.removeFromLists is defined and action.properties.removeFromLists is not empty %}
        {% for listId in action.properties.removeFromLists %}
            <span class="label label-red">
                <i class="ri-pie-chart-line"></i> {{ listId }}
            </span>
        {% endfor %}
    {% endif %}
{% endset %}

{% if footerContent|trim is not empty %}
    <div class="d-flex panel-footer as-stretch gap-3 ai-center">
        {{ footerContent|raw }}
    </div>
{% endif %}
