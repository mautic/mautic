{% set footerContent %}

    {# Add to points #}
    {% if action.properties.score is defined %}
        <span class="label
            {% if action.properties.score < 0 %}
                label-red
            {% elseif action.properties.score == 0 %}
                label-warm-gray
            {% else %}
                label-green
            {% endif %}">
            {{ 'mautic.form.form.change_points_by'|trans({'%value%': action.properties.score}) }}
        </span>
    {% endif %}

    {# Reply to contact #}
    {% if action.properties.set_replyto is defined and action.properties.set_replyto == 1 %}
        <span class="label label-green">
            {{ 'mautic.form.form.reply_to_contact'|trans }}
        </span>
    {% endif %}

    {# Send to owner #}
    {% if action.properties.email_to_owner is defined and action.properties.email_to_owner == 1 %}
        <span class="label label-green">
            {{ 'mautic.form.form.send_to_owner'|trans }}
        </span>
    {% endif %}

    {# Send to contact #}
    {% if action.properties.copy_lead is defined and action.properties.copy_lead == 1 %}
        <span class="label label-green">
            {{ 'mautic.form.form.send_to_contact'|trans }}
        </span>
    {% endif %}
{% endset %}

{% if footerContent|trim is not empty %}
    <div class="d-flex panel-footer as-stretch gap-3 ai-center">
        {{ footerContent|raw }}
    </div>
{% endif %}
