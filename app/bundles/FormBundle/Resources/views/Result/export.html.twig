{% set contentOnly = true %}
{% extends '@MauticCore/Default/content.html.twig' %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block headerTitle %}
  {{ 'mautic.form.result.header.index'|trans({'%name%': form.name}) }}
{% endblock %}

{% block content %}
  <div class="formresults">
      <table class="table table-hover formresult-list">
          <thead>
            <tr>
                <th class="col-formresult-id">{{ 'mautic.form.report.submission.id'|trans }}</th>
                <th class="col-formresult-id">{{ 'mautic.lead.report.contact_id'|trans }}</th>
                <th class="col-formresult-date">{{ 'mautic.form.result.thead.date'|trans }}</th>
                <th class="col-formresult-ip">{{ 'mautic.core.ipaddress'|trans }}</th>
                {% set fields = form.fields %}
                {% for f in fields %}
                  {% if f.type not in viewOnlyFields and true == f.saveResult %}
                    <th class="col-formresult-field col-formresult-{{ f.type }} col-formresult-field{{ f.id }}">{{ f.label }}</th>
                  {% endif %}
                {% endfor %}
            </tr>
          </thead>
          <tbody>
          {% for item in results %}
              <tr>
                  <td>{{ item['id'] }}</td>
                  <td>{{ item['leadId'] }}</td>
                  <td>{{ dateToFull(item['dateSubmitted'], 'UTC') }}</td>
                  <td>{{ item['ipAddress'] }}</td>
                  {% for key, r in item.results %}
                      {% set field = form.fields|filter(f => f.alias == key)|first %}
                      {% if field and field.type == 'boolean' %}
                          {% set properties = field.properties %}
                          {% if r['value'] == '1' or r['value'] == 'true' or r['value'] == 'yes' %}
                              <td>{{ properties.yes ?? 'Yes' }}</td>
                          {% elseif r['value'] == '0' or r['value'] == 'false' or r['value'] == 'no' %}
                              <td>{{ properties.no ?? 'No' }}</td>
                          {% elseif properties.yes is defined and r['value'] == properties.yes %}
                              <td>{{ properties.yes }}</td>
                          {% elseif properties.no is defined and r['value'] == properties.no %}
                              <td>{{ properties.no }}</td>
                          {% else %}
                              <td>{{ r['value'] }}</td>
                          {% endif %}
                      {% else %}
                          <td>{{ r['value'] }}</td>
                      {% endif %}
                  {% endfor %}
              </tr>
          {% endfor %}
          </tbody>
      </table>
  </div>
{% endblock %}
