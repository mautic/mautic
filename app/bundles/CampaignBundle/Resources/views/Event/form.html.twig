{#
  Variables
    - form
#}
{% form_theme form with [
      '@MauticCampaign/FormTheme/Event/_campaignevent_properties_row.html.twig',
] %}
{% if formTheme is defined %}
  {% form_theme form formTheme %}
{% endif %}
<div class="bundle-form">
    <div class="bundle-form-header mb-10">
        <h3>{{ eventHeader }}</h3>
        {% if eventDescription is defined %}
          <h6 class="text-secondary">{{ eventDescription|purify }}</h6>
        {% endif %}
    </div>

    {{ form_start(form) }}

    {{ form_widget(form.canvasSettings.droppedX) }}
    {{ form_widget(form.canvasSettings.droppedY) }}

    {{ form_row(form.name) }}

    {% if form.triggerMode is defined %}
    <div class="mb-lg{% if hideTriggerMode %} hide{% endif %}">
        {{ form_row(form.triggerMode) }}

        <div{% if ('date' != form.triggerMode.vars['data']) %} class="hide"{% endif %} id="triggerDate">
            {{ form_row(form.triggerDate) }}
        </div>

        <div{% if 'interval' != form.triggerMode.vars['data'] %} class="hide"{% endif %} id="triggerInterval">
            <div class="row">
                <div class="col-sm-4">
                    {{ form_row(form.triggerInterval) }}
                </div>
                <div class="col-sm-8">
                    {{ form_row(form.triggerIntervalUnit) }}
                </div>
            </div>
            <div id="interval_settings">
                <hr />
                <div class="row">
                    <div class="col-sm-12">
                        <div class="d-flex fd-row fw-nowrap ai-center gap-sm">
                            <div>{{ 'mautic.campaign.form.type.interval_schedule_at'|trans }} </div>
                            <div>{{ form_widget(form.triggerHour) }}</div>
                            <div> {{ 'mautic.campaign.form.type.interval_schedule_between_hours'|trans }} </div>
                            <div>{{ form_widget(form.triggerRestrictedStartHour) }}</div>
                            <div> {{ 'mautic.core.and'|trans }} </div>
                            <div>{{ form_widget(form.triggerRestrictedStopHour) }}</div>
                        </div>

                    </div>
                </div>
                <hr />
                <div class="row mt-5">
                    <div class="col-sm-12" style="font-weight: 600;">{{ 'mautic.campaign.form.type.interval_trigger_restricted_dow'|trans }}</div>
                </div>
                <div class="row">
                    <div class="col-sm-3">
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][0].vars.id, name: form['triggerRestrictedDaysOfWeek'][0].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][0].vars.value, checked: form['triggerRestrictedDaysOfWeek'][0].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][0].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][0].vars.label }]
} %}
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][1].vars.id, name: form['triggerRestrictedDaysOfWeek'][1].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][1].vars.value, checked: form['triggerRestrictedDaysOfWeek'][1].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][1].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][1].vars.label }]
} %}
                    </div>
                    <div class="col-sm-3">
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][2].vars.id, name: form['triggerRestrictedDaysOfWeek'][2].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][2].vars.value, checked: form['triggerRestrictedDaysOfWeek'][2].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][2].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][2].vars.label }]
} %}
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][3].vars.id, name: form['triggerRestrictedDaysOfWeek'][3].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][3].vars.value, checked: form['triggerRestrictedDaysOfWeek'][3].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][3].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][3].vars.label }]
} %}
                    </div>
                    <div class="col-sm-3">
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][4].vars.id, name: form['triggerRestrictedDaysOfWeek'][4].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][4].vars.value, checked: form['triggerRestrictedDaysOfWeek'][4].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][4].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][4].vars.label }]
} %}
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][5].vars.id, name: form['triggerRestrictedDaysOfWeek'][5].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][5].vars.value, checked: form['triggerRestrictedDaysOfWeek'][5].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][5].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][5].vars.label }]
} %}
                    </div>
                    <div class="col-sm-3">
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][6].vars.id, name: form['triggerRestrictedDaysOfWeek'][6].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][6].vars.value, checked: form['triggerRestrictedDaysOfWeek'][6].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][6].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][6].vars.label }]
} %}
                        {% include '@MauticCore/Components/checkbox.html.twig' with {
    items: [{ id: form['triggerRestrictedDaysOfWeek'][7].vars.id, name: form['triggerRestrictedDaysOfWeek'][7].vars.full_name, value: form['triggerRestrictedDaysOfWeek'][7].vars.value, checked: form['triggerRestrictedDaysOfWeek'][7].vars.checked, disabled: form['triggerRestrictedDaysOfWeek'][7].vars.disabled, label: form['triggerRestrictedDaysOfWeek'][7].vars.label }]
} %}
                    </div>
                </div>
            </div>
        </div>
        <div{% if ('optimized' != form.triggerMode.vars['data']) %} class="hide"{% endif %} id="triggerOptimized">
            <div class="row">
                <div class="col-xs-7">
                    <div class="mb-15">
                        {% for child in form.triggerWindow %}
                            <div>
                                {{ form_widget(child) }}
                                {{ form_label(child, null) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    <input type="hidden" name="submit" value="1">
    {{ form_end(form) }}
</div>
