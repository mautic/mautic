{% extends '@MauticCore/Default/content.html.twig' %}

{% block headerTitle %}{{ 'mautic.campaign.share.redirecting'|trans }}{% endblock %}

{% block content %}
<div class="box-layout">
    <div class="col-md-6 col-md-offset-3 height-auto">
        <div class="pa-lg text-center">
            <div class="panel panel-default">
                <div class="panel-body pa-lg">
                    <i class="ri-share-line ri-3x text-primary mb-md"></i>
                    <h3>{{ 'mautic.campaign.share.opening_marketplace'|trans }}</h3>
                    <p class="text-muted">{{ 'mautic.campaign.share.opening_marketplace.desc'|trans }}</p>
                    <a href="{{ redirectUrl }}" target="_blank" class="btn btn-primary btn-lg mt-md" id="marketplace-link">
                        {{ 'mautic.campaign.share.open_marketplace'|trans }}
                    </a>
                    <div class="mt-md">
                        <a href="{{ path('mautic_campaign_action', {'objectAction': 'view', 'objectId': campaignId}) }}">
                            {{ 'mautic.campaign.share.back_to_campaign'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    window.open('{{ redirectUrl|e('js') }}', '_blank');
</script>
{% endblock %}
