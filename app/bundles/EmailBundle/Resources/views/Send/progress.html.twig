{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent 'emailSend' %}

{% block headerTitle 'mautic.email.send.list'|trans({'%name%': email.name})|purify %}

{% set id = ('inprogress' != status) ? 'emailSendProgressComplete' : 'emailSendProgress' %}

{% block content %}
    <div class="row ma-24 email-send-progress" id="{{ id }}" data-email="{{ email.id }}" data-batchlimit="{{ batchlimit }}" data-pending="{{ progress[1] }}">
        <div class="col-sm-offset-3 col-sm-6">
            <div class="panel panel-{{ ('inprogress' != status) ? 'success' : 'danger' }}">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        {{ ('mautic.email.send.' ~ status)|trans({ '%subject%' : email.getSubject() })|purify }}
                    </h4>
                </div>
                <div class="panel-body">
                    {% if 'inprogress' != status %}
                        <h4>{{ 'mautic.email.send.stats'|trans({'%sent%': stats.sent, '%failed%': stats.failed}) }}</h4>
                    {% endif %}
                    {% include '@MauticCore/Components/progress-bar.html.twig' with {
                        label: 'mautic.email.send.sending_emails',
                        helperText: 'with_errors' == status
                            ? 'mautic.core.progress_bar.error'
                            : ('inprogress' != status
                                ? 'mautic.core.progress_bar.done'
                                : (progress[0] > 0 ? 'mautic.core.progress_bar.count'|trans({'%current%': progress[0], '%total%': progress[1]}) : 'mautic.core.progress_bar.preparing')),
                        value: progress[0] > 0 ? progress[0] : null,
                        max: progress[1],
                        status: 'inprogress' == status ? 'active' : ('with_errors' == status ? 'error' : 'finished'),
                        className: 'mt-16'
                    } %}
                </div>

                {% if stats.failedRecipients is not empty %}
                    <ul class="list-group">
                        {% for leadId, failedEmail in stats.failedRecipients %}
                            <li class="list-group-item">
                                <a target="_new" class="text-danger" href="{{ path('mautic_contact_action', {'objectAction': 'view', 'objectId': leadId}) }}">
                                    {{- failedEmail -}}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <div class="panel-footer text-center">
                    {% if 'inprogress' == status %}
                        <div>
                            <a class="text-danger mt-16"
                               href="{{ path('mautic_email_action', {'objectAction': 'send', 'objectId': email.id}) }}"
                               data-toggle="ajax">{{ 'mautic.core.form.cancel'|trans }}</a>
                        </div>
                    {% else %}
                        <div>
                            <a class="text-success mt-16"
                               href="{{ path('mautic_email_action', {'objectAction': 'view', 'objectId': email.id}) }}"
                               data-toggle="ajax">{{ 'mautic.core.form.done'|trans }}</a>
                        </div>
                    {% endif %}
                </div>
            </div>

        {% if 'inprogress' == status %}
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [
                {
                    label: 'mautic.email.send.exit_screen'|trans,
                    variant: 'link',
                    icon: 'ri-information-line',
                    attributes: {
                        'data-bs-toggle': 'popover',
                        'data-bs-content': 'mautic.email.send.help_subheading_leaving'|trans,
                        'data-bs-placement': 'bottom',
                        'data-bs-container': 'body',
                        'data-bs-title': 'mautic.email.send.help_heading_leaving'|trans,
                    }
                }
            ]
        } %}
        {% endif %}
        </div>
    </div>
{% endblock %}
