{% set isIndex = 'index' == tmpl %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent 'pointInsight' %}

{% block headerTitle 'mautic.points.menu.insight'|trans %}

{% block content %}
    {% if isIndex %}
        <div class="panel panel-default bdr-t-wdh-0">
            {{ include('@MauticCore/Helper/list_toolbar.html.twig', {
                'searchValue': searchValue,
                'action': currentRoute,
                'searchHelp': 'mautic.point.help.searchcommands',
                'filters': {
                    'placeholder': 'mautic.core.search.placeholder'|trans
                }
            }) }}
            <div class="page-list">
    {% endif %}

    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered point-list">
            <thead>
                <tr>
                    <th>{{ 'mautic.core.id'|trans }}</th>
                    <th>{{ 'mautic.core.name'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% if items|length > 0 %}
                    {% for item in items %}
                        <tr>
                            <td>{{ item.id }}</td>
                            <td>{{ item.name }}</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="2">{{ 'mautic.core.noresults'|trans }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    {% if isIndex %}
            </div>
        </div>
    {% endif %}
{% endblock %} 