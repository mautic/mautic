{% set inline = menuRender('profile') %}
<li class="dropdown">
    <a class="dropdown-toggle" data-bs-toggle="dropdown" href="#" aria-label={{ 'mautic.lead.lead.social.profile'|trans }}>
        <i class="ri-account-circle-line ri-xl"></i>
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <div class="dropdown-menu-user row-no-gutters flex-nowrap ma-16">
                <span class="img-wrapper"><img src="{{ userAvatar(app.getUser().getId()) }}" alt=""></span>
                <span class="d-flex flex-column justify-content-center ms-12 info">
                    <span class="text text-nowrap fw-sb">{{ app.getUser().getName() }}</span>
                    {% if app.getUser().getPosition() %}
                        <span class="text-nowrap small">{{ app.getUser().getPosition() }}</span>
                    {% endif %}
                </span>
            </div>
        </li>

        {% if inline %}
        <li role="separator" class="divider"></li>
        {# menuRender returns trusted HTML, but assigning it to a variable drops Twig's safe marker. #}
        {{ inline|raw }}
        {% endif %}
    </ul>
</li>
