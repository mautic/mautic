{% extends "@MauticCore/Theme/email-validation.html.twig" %}

{% block validation_content %}
    {% block forward_content %}
        <div class="well validation-card">
            <h1 class="text-center">{{ 'mautic.email.forward.header'|trans }}</h1>
            {% if message is defined and message is not empty %}
                <p class="text-center">{{ message }}</p>
            {% else %}
                <p>{{ 'mautic.email.forward.message'|trans }}</p>
                {{ form_start(form) }}
                {{ form_label(emailAddressField) }}
                <div class="input-group {% if not emailAddressValid %}has-error{% endif %}">
                    {{ form_widget(emailAddressField) }}
                    <span class="input-group-btn">
                        {{ form_row(submitField) }}
                    </span>
                </div>
                {% if emailAddressHasErrors or formHasErrors %}
                    <div class="validate-alert" role="alert" aria-live="polite">
                        {{ form_errors(form) }}
                        {{ form_errors(emailAddressField) }}
                    </div>
                {% endif %}
                {{ form_end(form) }}
            {% endif %}
        </div>
    {% endblock %}
{% endblock %}
