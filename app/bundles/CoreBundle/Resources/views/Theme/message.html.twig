{% extends "@MauticCore/Theme/base.html.twig" %}

{% block stylesheets %}{% endblock %}
{% block content %}

    {% set message_type = message_type|default('') %}
    {% if message_type in ['resubscribed', 'unsubscribed'] %}
        <div style="min-height: 98vh;
                    display: flex;
                    flex-direction: column;
                    padding: 0 15px;
                    width: 300px;
                    margin: 0 auto;
                    text-align: center;
                    font-family: sans-serif;
                    line-height: 1.3em;
                    justify-content: center;">
            {{ include('@MauticEmail/Lead/' ~ message_type ~ '.html.twig') }}
        </div>
    {% else %}
        {{ message|raw }}
    {% endif %}

{% endblock %}
