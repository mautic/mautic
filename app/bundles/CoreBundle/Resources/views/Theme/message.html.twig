{% extends "@MauticCore/Theme/base.html.twig" %}

{% block stylesheets %}{% endblock %}
{% block content %}
    {% set message_type = message_type|default('') %}
{% if message_type != 'preference_center' %}
    {% include '@MauticCore/Theme/_message_styles.html.twig' %}
{% endif %}
<div class="container min-h-100vh justify-content-center">
    {% block message_content %}

    {% if message_type in ['resubscribed', 'unsubscribed'] %}
        <div style="min-height: 98vh; display: flex; flex-direction: column; padding: 0 15px; width: 300px; margin: 0 auto; text-align: center; font-family: sans-serif; line-height: 1.3em; justify-content: center;">
            {{ include('@MauticEmail/Lead/' ~ message_type ~ '.html.twig') }}
        </div>
    {% elseif message_type == 'preference_center' %}
        {{ message|raw }}

    {% else %}
    <div class="row align-self-center justify-content-center">
        <div class="col-md-5 col-xs-12 text-center">
            <span class="fs-16">{{ message|raw }}</span>
        </div>
    </div>
    {% endif %}

    {% endblock %}

</div>
{% endblock %}
