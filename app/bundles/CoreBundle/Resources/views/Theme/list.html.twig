{% set isIndex = tmpl == 'index' %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent 'theme' %}

{% block headerTitle 'mautic.core.themes'|trans %}

{% block actions %}
    {% include "@MauticCore/Theme/form.html.twig" with { form: form } %}
{% endblock %}

{% block content %}
{% if isIndex %}
<div id="page-list-wrapper" class="panel panel-default">
    {% include "@MauticCore/Helper/list_toolbar.html.twig" with {
        action: currentRoute,
        searchValue: searchValue|default(''),
        searchScopes: searchScopes|default([]),
        searchScopeHint: searchScopeHint|default(null),
        'bulk_actions': {
            'langVar': 'core.theme',
            'routeBase': 'themes',
            'templateButtons': {
                'delete': permissions['core:themes:delete'],
            },
        },
    } %}
    <div class="page-list">
        {{ include('@MauticCore/Theme/_list_results.html.twig') }}
    </div>
</div>
{% else %}
    {{ include('@MauticCore/Theme/_list_results.html.twig') }}
{% endif %}
{% endblock %}
