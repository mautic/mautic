{#
Variables
  - formThemes
  - form
#}
{% if formThemes is not empty and formThemes is iterable %}
    {% form_theme form with formThemes %}
{% elseif formThemes is not empty and formThemes is string %}
    {% form_theme form formThemes %}
{% endif %}

{% for child in form %}
    {{ form_row(child) }}
{% endfor %}
