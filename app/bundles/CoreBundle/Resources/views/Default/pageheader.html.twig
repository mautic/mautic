<div class="page-header">
	<div class="row-no-gutters align-items-lg-center gap-md flex-lg-nowrap flex-lg-row flex-column-reverse">
		<div class="col-xs-12 col-sm-6 col-md-5 align-middle">
			<div class="d-flex flex-column flex-wrap flex-lg-nowrap">
				{{ preHeader|raw }}
				<h1 class="pull-left page-header-title">{{ headerTitle|purify }}</h1>
			<div class="mt-lg d-flex gap-xs">{{ publishStatus|raw }}</div>
			{{ customContent('page.header.left', _context) }}
			</div>

		</div>
		<div class="col-xs-12 col-sm-6 col-md-7 align-middle">
			<div class="d-flex toolbar justify-content-lg-end justify-content-start" id="toolbar">
				{# only print if it's a string beause that contains HTML,
						eg. in PointsBundle and FormBundle's 'new' pages it's outputting an Array #}
				{{ actions is not iterable ? actions|raw }}

				<div class="toolbar-bundle-buttons pull-left">{{ toolbar }}</div>
				<div class="toolbar-form-buttons btn-group hide pull-right">
					<div class="toolbar-standard hidden-xs hidden-sm "></div>
					<div class="toolbar-dropdown hidden-md hidden-lg">
						<button type="button" class="btn btn-primary btn-main"></button>
						<button type="button" class="btn btn-ghost btn-nospin  dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
							<i class="ri-arrow-drop-down-line"></i>
						</button>
						<ul class="dropdown-menu dropdown-menu-right" role="menu"></ul>
					</div>
				</div>
				{{ customContent('page.header.right', _context) }}
			</div>
			<div class="clearfix"></div>
		</div>
	</div>
</div>
