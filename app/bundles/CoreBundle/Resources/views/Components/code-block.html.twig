{% set lines = innerText|trim('\n', 'right')|split('\n') %}
{% set collapsedLines = collapsedLines|default(5) %}
{% set collapsible = lines|length > collapsedLines %}
{% set blockId = 'code-block-' ~ random() %}
{% set captionId = blockId ~ '-caption' %}
{% set bodyId = blockId ~ '-body' %}
<figure id="{{ blockId }}" aria-labelledby="{{ captionId }}" class="code-block{{ wrap|default(false) ? ' code-block--wrap' : '' }}{{ numbered|default(false) ? ' code-block--numbered' : '' }}" data-code-block data-collapsed-lines="{{ collapsedLines }}">
    <div class="code-block__header type-label-01">
        <span id="{{ captionId }}" class="code-block__filename"><i class="ri-file-code-line fs-14" aria-hidden="true"></i>{{ filename|default(language|default('code')) }}</span>
        {% if hideCopyButton is not defined or not hideCopyButton %}
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [{
            variant: 'ghost',
            size: 'xs',
            icon: 'ri-file-copy-line',
            icon_only: true,
            label: copyButtonDescription|default('mautic.core.copy_code_snippet')|trans,
            attributes: {
                'data-copy': copyText|default(innerText)|escape('html_attr'),
                'type': 'button',
            },
            }]
        } %}
        {% endif %}
    </div>
    <div id="{{ bodyId }}" class="code-block__body" role="group" aria-label="{{ ariaLabel|default(filename|default(language|default('code'))) }}">
        <ol class="code-block__lines">
            {% for line in lines %}
            <li class="code-block__line"{% if collapsible and loop.index > collapsedLines %} hidden data-code-block-extra{% endif %}><code>{{ line|default(' ') }}</code></li>
            {% endfor %}
        </ol>
    </div>
    {% if collapsible %}
    <button type="button" class="code-block__toggle btn btn-xs btn-nospin" aria-expanded="false" aria-controls="{{ bodyId }}" data-code-block-toggle data-more="{{ 'mautic.core.code_block.more_lines'|trans({'%count%': lines|length - collapsedLines}) }}" data-less="{{ 'mautic.core.code_block.collapse'|trans }}">
        <span data-code-block-label>{{ 'mautic.core.code_block.more_lines'|trans({'%count%': lines|length - collapsedLines}) }}</span><i class="ri-arrow-down-s-line" aria-hidden="true"></i>
    </button>
    {% endif %}
</figure>
