{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set variant = variant|default('default') %}
{% set labelText = labelText|default('mautic.core.forms.field.search') %}
{% set size = size is defined and size in ['xs', 'sm', 'md', 'lg'] ? size : 'md' %}
{% set wrapperClass = wrapperClass|default(null) %}
{% set attributes = attributes|default({}) %}
{% set label_id = id ~ '-label' %}
{% set hasValue = hasValue is defined ? hasValue : (value|default('') is not same as('')) %}
{% set clear_label = (closeButtonLabelText|default('mautic.core.forms.field.clear_search'))|trans %}
{% set control %}
    {% include '@MauticCore/Components/form-control.html.twig' with {
        id: id,
        name: name|default('input'),
        type: 'search',
        label: null,
        value: value|default(''),
        placeholder: placeholder|default(null),
        disabled: disabled|default(false),
        readonly: readonly|default(false),
        required: false,
        wrapperClass: '',
        render_feedback: false,
        attributes: attributes|merge({autocomplete: autoComplete|default('off')})
    } only %}
{% endset %}
{% set clear %}
    <button type="button" class="form-field-clear" aria-label="{{ clear_label|e('html_attr') }}" title="{{ clear_label|e('html_attr') }}"{{ hasValue ? '' : ' hidden' }}{{ (disabled|default(false) or readonly|default(false)) ? ' disabled' : '' }}>
        <i class="ri-close-line" aria-hidden="true"></i>
    </button>
{% endset %}
{% if variant == 'fluid' %}
<div class="form-fluid form-fluid--search{{ (wrapperClass ? ' ' ~ wrapperClass : '')|e('html_attr') }}" role="search" aria-labelledby="{{ label_id|e('html_attr') }}">
    <div class="form-fluid__label text-helper">
        <label id="{{ label_id|e('html_attr') }}" for="{{ id|e('html_attr') }}" class="form-label type-label-01 mb-0">{{ labelText|trans }}</label>
    </div>
    <div class="form-field-with-action">
        {{ control|raw }}
        <i class="ri-search-line form-field-icon" aria-hidden="true"></i>
        {{ clear|raw }}
    </div>
</div>
{% elseif variant == 'expandable' %}
<div class="search-expandable{{ (wrapperClass ? ' ' ~ wrapperClass : '')|e('html_attr') }}" role="search" aria-label="{{ labelText|trans|e('html_attr') }}" data-search-expandable data-size="{{ size|e('html_attr') }}">
    <button type="button" class="btn btn-ghost btn--icon-only btn-nospin search-expandable__toggle" aria-expanded="false" aria-controls="{{ id|e('html_attr') }}" aria-label="{{ labelText|trans|e('html_attr') }}" title="{{ labelText|trans|e('html_attr') }}">
        <i class="ri-search-line" aria-hidden="true"></i>
    </button>
    <div class="search-expandable__field form-field-with-action flex-grow-1" hidden>
        <label for="{{ id|e('html_attr') }}" class="visually-hidden">{{ labelText|trans }}</label>
        {{ control|raw }}
        <i class="ri-search-line form-field-icon form-field-icon--start" aria-hidden="true"></i>
        {{ clear|raw }}
    </div>
</div>
{% else %}
<div class="form-field-with-action{{ (wrapperClass ? ' ' ~ wrapperClass : '')|e('html_attr') }}" role="search" aria-labelledby="{{ label_id|e('html_attr') }}" data-size="{{ size|e('html_attr') }}">
    <label id="{{ label_id|e('html_attr') }}" for="{{ id|e('html_attr') }}" class="visually-hidden">{{ labelText|trans }}</label>
    {{ control|raw }}
    <i class="ri-search-line form-field-icon form-field-icon--start" aria-hidden="true"></i>
    {{ clear|raw }}
</div>
{% endif %}
