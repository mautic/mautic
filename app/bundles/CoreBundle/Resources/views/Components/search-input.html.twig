{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set variant = variant|default('default') %}
{% set labelText = labelText|default('mautic.core.forms.field.search') %}
{% set size = size is defined and size in ['xs', 'sm', 'md', 'lg'] ? size : 'md' %}
{% set wrapperClass = wrapperClass|default(null) %}
{% set attributes = attributes|default({}) %}
{% set label_id = id ~ '-label' %}
{% set clear_label = (closeButtonLabelText|default('mautic.core.forms.field.clear_search'))|trans %}
{% set control %}
    {% include '@MauticCore/Components/form-control.html.twig' with {
        id: id,
        name: name|default('input'),
        type: 'search',
        label: null,
        value: value|default(''),
        placeholder: placeholder|default(null),
        disabled: disabled|default(false),
        readonly: readonly|default(false),
        required: false,
        wrapperClass: '',
        render_feedback: false,
        attributes: attributes|merge({autocomplete: autoComplete|default('off')})
    } only %}
{% endset %}
{% set clear %}
    <button type="button" class="form-field-clear" aria-label="{{ clear_label }}" title="{{ clear_label }}"{{ value|default('') is same as('') ? ' hidden' : '' }}>
        <i class="ri-close-line" aria-hidden="true"></i>
    </button>
{% endset %}
{% if variant == 'fluid' %}
<div class="form-fluid form-fluid--search{{ wrapperClass ? ' ' ~ wrapperClass : '' }}" role="search" aria-labelledby="{{ label_id }}">
    <div class="form-fluid__label text-helper">
        <label id="{{ label_id }}" for="{{ id }}" class="form-label type-label-01 mb-0">{{ labelText|trans }}</label>
    </div>
    <div class="form-field-with-action">
        {{ control|raw }}
        <i class="ri-search-line form-field-icon" aria-hidden="true"></i>
        {{ clear|raw }}
    </div>
</div>
{% elseif variant == 'expandable' %}
<div class="search-expandable{{ wrapperClass ? ' ' ~ wrapperClass : '' }}" role="search" aria-label="{{ labelText|trans }}" data-search-expandable data-size="{{ size }}">
    <button type="button" class="btn btn-ghost btn--icon-only btn-nospin search-expandable__toggle" size="{{ size }}" aria-expanded="false" aria-controls="{{ id }}" aria-label="{{ labelText|trans }}" title="{{ labelText|trans }}">
        <i class="ri-search-line" aria-hidden="true"></i>
    </button>
    <div class="search-expandable__field form-field-with-action flex-grow-1" hidden>
        <label for="{{ id }}" class="visually-hidden">{{ labelText|trans }}</label>
        {{ control|raw }}
        <i class="ri-search-line form-field-icon form-field-icon--start" aria-hidden="true"></i>
        {{ clear|raw }}
    </div>
</div>
{% else %}
<div class="form-field-with-action{{ wrapperClass ? ' ' ~ wrapperClass : '' }}" role="search" aria-labelledby="{{ label_id }}" data-size="{{ size }}">
    <label id="{{ label_id }}" for="{{ id }}" class="visually-hidden">{{ labelText|trans }}</label>
    {{ control|raw }}
    <i class="ri-search-line form-field-icon form-field-icon--start" aria-hidden="true"></i>
    {{ clear|raw }}
</div>
{% endif %}
