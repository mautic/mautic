{% set size = size|default('md') in ['sm', 'md', 'lg'] ? size|default('md') : 'md' %}
{% set dimensions = {'sm': {'icon': 12, 'ring': 20, 'stroke': 2}, 'md': {'icon': 14, 'ring': 24, 'stroke': 2}, 'lg': {'icon': 17, 'ring': 30, 'stroke': 2.5}}[size] %}
{% set duration = duration is defined ? max(0, duration) : 1200 %}
{% set resetDelay = resetDelay is defined ? max(0, resetDelay) : 1500 %}
{% set label = label|default('mautic.core.hold_to_confirm.label') %}
{% set confirmedLabel = confirmedLabel|default('mautic.core.hold_to_confirm.confirmed') %}
{% set variant = variant|default('danger') %}
{% set variant = variant == 'destructive' ? 'danger' : (variant in ['danger', 'neutral', 'beam'] ? variant : 'danger') %}
<span class="hold-to-confirm {{ variant == 'beam' ? beamClassName|default('') : '' }}" data-component="hold-to-confirm" data-size="{{ size }}" data-variant="{{ variant }}" data-duration="{{ duration }}" data-reset-delay="{{ resetDelay }}" data-state="idle" data-instructions="{{ 'mautic.core.hold_to_confirm.instructions'|trans }}" data-theme="{{ theme|default('auto') }}" data-color-variant="{{ colorVariant|default('sunset') }}" data-strength="{{ strength is defined ? strength : 0.65 }}" data-beam-enabled="{{ active is defined and active == false ? 'false' : 'true' }}">
    <button type="button" class="btn btn-tertiary {{ variant == 'danger' ? 'btn-danger' : '' }} hold-to-confirm__button {{ className|default('') }}" aria-label="{{ 'mautic.core.hold_to_confirm.instructions'|trans({'%label%': label|trans, '%seconds%': (duration / 1000)|number_format(1, '.', '')|trim('0', 'right')|trim('.', 'right')}) }}"{% if id is defined %} id="{{ id }}"{% endif %}{% if disabled|default(false) %} disabled{% endif %}>
        <span class="hold-to-confirm__symbol" aria-hidden="true" style="width: {{ dimensions.ring }}px; height: {{ dimensions.ring }}px;">
            <span class="hold-to-confirm__icon">
                {% block icon %}<i class="{{ icon|default('ri-delete-bin-line') }}" data-default-icon aria-hidden="true"></i>{% endblock %}
            </span>
            <span class="hold-to-confirm__check"><svg viewBox="0 0 24 24" width="{{ dimensions.icon }}" height="{{ dimensions.icon }}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M20 6 9 17l-5-5"/></svg></span>
            <svg class="hold-to-confirm__ring" viewBox="0 0 {{ dimensions.ring }} {{ dimensions.ring }}" width="{{ dimensions.ring }}" height="{{ dimensions.ring }}">
                <circle cx="{{ dimensions.ring / 2 }}" cy="{{ dimensions.ring / 2 }}" r="{{ (dimensions.ring - dimensions.stroke) / 2 }}" fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="{{ dimensions.stroke }}"/>
                <circle class="hold-to-confirm__progress" pathLength="1" cx="{{ dimensions.ring / 2 }}" cy="{{ dimensions.ring / 2 }}" r="{{ (dimensions.ring - dimensions.stroke) / 2 }}" fill="none" stroke="currentColor" stroke-width="{{ dimensions.stroke }}" stroke-linecap="round" stroke-dasharray="1" stroke-dashoffset="1"/>
            </svg>
        </span>
        <span class="hold-to-confirm__label"><span data-idle-label>{{ label|trans }}</span><span data-confirmed-label hidden>{{ confirmedLabel|trans }}</span></span>
        <span class="hold-to-confirm__status" role="status" aria-live="polite"></span>
    </button>
</span>
