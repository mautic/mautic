{% set items = items|default([]) %}
{% set name = name|default('checkbox') %}
{% set legend = legend|default(null) %}
{% set helpText = helpText|default(null) %}
{% set wrapperClass = wrapperClass|default('') %}
{% set inline = inline|default(false) %}
{% set reverse = reverse|default(false) %}
{% set required = required|default(false) %}
{% set base_id = name|replace({'[': '-', ']': '', ' ': '-', '.': '-'}) %}
{% set help_id = helpText ? base_id ~ '-help' : null %}

<fieldset class="{{ [wrapperClass, 'border-0', 'p-0', 'm-0']|filter(value => value is not empty)|join(' ') }}">
    {% if legend %}
        <legend class="form-label mb-2">{{ legend|trans }}</legend>
    {% endif %}

    {% for item in items %}
        {% set item_label = item.label|default('') %}
        {% if item is defined and item.label is defined and item.label is null %}
            {% set item_label = (item.name|default(name))|replace({'[': ' ', ']': ' ', '_': ' '})|trim|humanize %}
        {% endif %}
        {% set item_value = item.value is defined ? item.value : loop.index0 %}
        {% set item_id = item.id|default(base_id ~ '-' ~ loop.index0 ~ '-' ~ item_value|replace({' ': '-', '.': '-', '_': '-', '[': '-', ']': ''})|lower) %}
        {% set item_name = item.name|default(name) %}
        {% set item_attributes = item.attributes|default({}) %}
        {% set classes = ['form-check'] %}

        {% if inline %}
            {% set classes = classes|merge(['form-check-inline']) %}
        {% endif %}

        {% if reverse %}
            {% set classes = classes|merge(['form-check-reverse']) %}
        {% endif %}

        <div class="{{ classes|join(' ') }}">
            {% set input_classes = ['form-check-input'] %}
            {% if item.className|default('') %}
                {% set input_classes = input_classes|merge([item.className]) %}
            {% endif %}
            {% if item_attributes.class is defined and item_attributes.class is not empty %}
                {% set input_classes = input_classes|merge([item_attributes.class]) %}
            {% endif %}
            <input
                class="{{ input_classes|join(' ')|escape }}"
                type="checkbox"
                name="{{ item_name|escape }}"
                id="{{ item_id|escape }}"
                value="{{ item_value|escape }}"
                {% if help_id %}aria-describedby="{{ help_id|escape }}"{% endif %}
                {% if item.checked|default(false) %}checked{% endif %}
                {% if item.disabled|default(false) %}disabled{% endif %}
                {% if required %}required{% endif %}
                {% for attr_key, attr_value in item_attributes %}
                    {% if attr_key != 'class' and attr_value is not same as(false) and attr_value is not null %}
                    {{ attr_key|escape }}="{{ attr_value|escape }}"
                    {% endif %}
                {% endfor %}
            >
            {% if item_label %}
            <label class="form-check-label" for="{{ item_id }}"{% for label_key, label_value in item.labelAttributes|default({}) %} {{ label_key }}="{{ label_value }}"{% endfor %}>
                {{ item_label|trans }}
            </label>
            {% endif %}
        </div>
    {% endfor %}

    {% if helpText %}
        <div id="{{ help_id }}" class="form-text">{{ helpText|trans }}</div>
    {% endif %}
</fieldset>
