{% set id = id|default(name|default('input-group')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set label = label|default(null) %}
{% set helpText = helpText|default(null) %}
{% set help_id = helpText ? id ~ '-help' : null %}
{% set feedback_id = id ~ '-feedback' %}
{% set size = size|default(null) %}
{% set wrapperClass = wrapperClass|default('') %}
{% set addons_prepend = addons_prepend|default([]) %}
{% set addons_append = addons_append|default([]) %}
{% set control = control|default({}) %}
{% set attributes = attributes|default({}) %}
{% set group_class = 'input-group' %}

{% if size in ['sm', 'lg'] %}
    {% set group_class = group_class ~ ' input-group-' ~ size %}
{% endif %}

{% if attributes.class is defined %}
    {% set group_class = group_class ~ ' ' ~ attributes.class %}
{% endif %}

{% set group_class = group_class ~ ' has-validation' %}

<div class="{% if wrapperClass %}{{ wrapperClass }}{% endif %}">
    {% if label %}
        <label for="{{ control.id|default(id ~ '-control') }}" class="form-label">
            {{ control.required|default(false) ? 'mautic.marketplace.forms.field.required'|trans({'%fieldLabel%': label|trans}) : label|trans }}
        </label>
    {% endif %}

    <div
        class="{{ group_class|trim }}"
        {% for attribute, attribute_value in attributes %}
            {% if attribute != 'class' %}
                {{ attribute }}="{{ attribute_value }}"
            {% endif %}
        {% endfor %}
    >
        {% for addon in addons_prepend %}
            <span class="input-group-text position-relative prepend">{{ addon|raw }}</span>
        {% endfor %}

        {% set control_type = control.component|default('form-control') %}
        {% set control_context = control|merge({
            id: control.id|default(id ~ '-control'),
            label: null,
            helpText: null,
            wrapperClass: '',
            help_id: help_id,
            feedback_id: feedback_id,
            render_feedback: false,
            describedby: help_id ? [help_id] : [],
        }) %}
        {% include '@MauticCore/Components/' ~ control_type ~ '.html.twig' with control_context only %}

        {% for addon in addons_append %}
            <span class="input-group-text position-relative append">{{ addon|trans }}</span>
        {% endfor %}
    </div>

    {% if helpText %}
        <div id="{{ help_id }}" class="form-text">{{ helpText|trans }}</div>
    {% endif %}

    <div id="{{ feedback_id }}" class="invalid-feedback" hidden aria-live="polite"></div>
</div>
