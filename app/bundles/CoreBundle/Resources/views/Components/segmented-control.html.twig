{% set size = size|default('md') %}
{% set controlId = id|default('segmented-control-' ~ random()) %}
<div class="btn-group segmented-control segmented-control--{{ size|e('html_attr') }}{{ equalWidth|default(false) ? ' segmented-control--equal' : '' }}{{ (draggable ?? true) ? ' segmented-control--draggable' : '' }} {{ className|default('')|e('html_attr') }}" id="{{ controlId|e('html_attr') }}" role="radiogroup"{% if duration is defined %} style="--segmented-control-duration: {{ duration|e('html_attr') }}s"{% endif %}{% if label is defined %} aria-label="{{ ((translation_domain ?? null) is same as(false) ? label : label|trans(label_translation_parameters|default({}), translation_domain|default(null)))|e('html_attr') }}"{% endif %}>
    <span class="segmented-control__indicator" aria-hidden="true"></span>
    {% for option in options %}
        <input type="radio" class="btn-check{{ option.attr.class|default('') ? ' ' ~ option.attr.class|e('html_attr') : '' }}" name="{{ name|default(controlId)|e('html_attr') }}" id="{{ controlId|e('html_attr') }}_{{ loop.index0 }}" value="{{ option.value|e('html_attr') }}" autocomplete="off"{% for attrName, attrValue in attr|default({})|filter((v, k) => v is not same as(false)) %} {{ attrName|e('html_attr') }}="{{ attrValue|e('html_attr') }}"{% endfor %}{% for attrName, attrValue in option.attr|default({})|filter((v, k) => v is not same as(false) and k != 'class') %} {{ attrName|e('html_attr') }}="{{ attrValue|e('html_attr') }}"{% endfor %}{{ option.value is same as(value ?? options[0].value) ? ' checked' : '' }}{{ option.disabled|default(false) ? ' disabled' : '' }}{{ option.required|default(false) ? ' required' : '' }}>
        <label class="btn" for="{{ controlId|e('html_attr') }}_{{ loop.index0 }}">
            {% if option.icon is defined and option.icon %}<i class="{{ option.icon|e('html_attr') }}" aria-hidden="true"></i>{% endif %}
            {{ (option.translation_domain ?? null) is same as(false) ? option.label : option.label|trans(option.label_translation_parameters|default({}), option.translation_domain|default(null)) }}
        </label>
    {% endfor %}
</div>
