{% set size = size|default('md') %}
{% set controlId = id|default('segmented-control-' ~ random()) %}
<div class="btn-group segmented-control segmented-control--{{ size }}{{ equalWidth|default(false) ? ' segmented-control--equal' : '' }}{{ draggable|default(true) ? ' segmented-control--draggable' : '' }} {{ className|default('') }}" id="{{ controlId }}" role="radiogroup"{% if duration is defined %} style="--segmented-control-duration: {{ duration }}s"{% endif %}{% if label is defined %} aria-label="{{ translation_domain|default(null) is same as(false) ? label : label|trans(label_translation_parameters|default({}), translation_domain|default(null)) }}"{% endif %}>
    <span class="segmented-control__indicator" aria-hidden="true"></span>
    {% for option in options %}
        <input type="radio" class="btn-check" name="{{ name|default(controlId) }}" id="{{ controlId }}_{{ loop.index0 }}" value="{{ option.value }}" autocomplete="off"{% for attrName, attrValue in attr|default({}) %} {{ attrName }}="{{ attrValue }}"{% endfor %}{{ option.value == value|default(options[0].value) ? ' checked' : '' }}{{ option.disabled|default(false) ? ' disabled' : '' }}{{ option.required|default(false) ? ' required' : '' }}>
        <label class="btn" for="{{ controlId }}_{{ loop.index0 }}">
            {% if option.icon is defined and option.icon %}<i class="{{ option.icon }}" aria-hidden="true"></i>{% endif %}
            {{ option.label|trans }}
        </label>
    {% endfor %}
</div>
