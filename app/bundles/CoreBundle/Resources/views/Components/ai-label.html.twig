{% set inline = inline|default(false) %}
{% set size = size|default(inline ? 'md' : 'xs') %}
{% set label = label|default('mautic.core.ai.label') %}
{% set additionalText = additionalText|default(null) %}
{% set classes = ['ai-label__button', 'ai-label__button--' ~ size] %}
{% if inline %}{% set classes = classes|merge(['ai-label__button--inline']) %}{% endif %}
{% if static is defined and static %}{% set classes = classes|merge(['ai-label__button--static']) %}{% endif %}
{% if additionalText %}{% set classes = classes|merge(['ai-label__button--with-content']) %}{% endif %}
<span class="ai-label{{ className is defined and className ? ' ' ~ className : '' }}">
    {% if static is defined and static %}
    <span class="{{ classes|join(' ') }}" role="img" aria-label="{{ 'mautic.core.ai.label'|trans }}"><span class="ai-label__text">{{ label|trans }}</span></span>
    {% else %}
    <button type="button"
        class="{{ classes|join(' ') }}"
        data-bs-toggle="popover"
        data-bs-container="body"
        data-bs-custom-class="ai-popover"
        data-bs-placement="{{ placement|default('bottom')|e('html_attr') }}"
        data-bs-html="{{ html is defined and html ? 'true' : 'false' }}"
        data-bs-trigger="{{ trigger|default('focus')|e('html_attr') }}"
        title="{{ title|default('mautic.core.ai.explainability.title')|trans|e('html_attr') }}"
        {% if content is defined and content %}data-bs-content="{{ content|trans|e('html_attr') }}"{% endif %}
        aria-haspopup="true"
        aria-label="{{ aria_label|default('mautic.core.ai.explainability')|trans|e('html_attr') }}"
    >
        <span class="ai-label__text">{{ label|trans }}</span>
        {% if additionalText %}<span class="ai-label__additional-text">{{ additionalText|trans }}</span>{% endif %}
    </button>
    {% endif %}
</span>
