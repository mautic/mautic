{# === INLINE VARIANT === #}
{% set description = copyButtonDescription|default('mautic.core.copy_code_snippet')|trans %}
{% set default_id = 'mautic.core.copy_code_snippet'|trans|lower|replace({' ': '-'}) %}

{% if variant == 'inline' %}
<a class="code-snippet code-snippet--inline" {% if disabled is defined and disabled %}disabled{% endif %} data-toggle="tooltip" title="{{ description }}" {% if disabled is not defined or not disabled %} data-copy="{{ copyText|default(innerText)|escape('html_attr') }}" tabindex="0"{% endif %}>
    <code class="code-snippet__code {{ className|default('') }}" aria-label="{{ ariaLabel|default(description) }}">
        {{ innerText|escape('html_attr') }}
    </code>
</a>

{# === SINGLE VARIANT === #}
{% elseif variant == 'single' %}
<div class="code-snippet code-snippet--single" {% if disabled is defined and disabled %}disabled{% endif %}>
    <code class="code-snippet__code {{ className|default('') }}" aria-label="{{ ariaLabel|default(description) }}">
        {{ innerText|escape('html_attr') }}
    </code>
    {% if hideCopyButton is not defined or not hideCopyButton %}
    {% include '@MauticCore/Helper/button.html.twig' with {
        buttons: [{
        variant: 'ghost',
        size: 'xs',
        icon: 'ri-file-copy-line',
        icon_only: true,
        label: description,
        attributes: {
            'data-copy': copyText|default(innerText)|escape('html_attr'),
            'type': 'button',
            'id': default_id
        },
        }]
    } %}
    {% endif %}
</div>

{# === MULTI VARIANT === #}
{% elseif variant == 'multi' %}
<div class="code-snippet code-snippet--multi" {% if disabled is defined and disabled %}disabled{% endif %}>
    <pre class="code-snippet__code {{ className|default('') }}" aria-label="{{ ariaLabel|default(description) }}">{{ innerText|raw }}</pre>
    {% if hideCopyButton is not defined or not hideCopyButton %}
    {% include '@MauticCore/Helper/button.html.twig' with {
        buttons: [{
        variant: 'ghost',
        icon: 'ri-file-copy-line',
        icon_only: true,
        label: copyButtonDescription|default('mautic.core.copy_code_snippet')|trans,
        attributes: {
            'data-copy': copyText|default(innerText)|escape('html_attr'),
            'type': 'button',
            'id': default_id
        },
        }]
    } %}
    {% endif %}
</div>
{% endif %}
