{% set state = checked is defined ? checked : defaultChecked|default(false) %}
{% set stateName = state is same as('indeterminate') ? 'indeterminate' : (state == true ? 'checked' : 'unchecked') %}
{% set size = size|default('default') %}
{% set variant = variant|default('default') %}
<span class="acervo-checkbox" data-component="animated-checkbox" data-size="{{ size }}" data-variant="{{ variant }}" data-state="{{ stateName }}" data-default-state="{{ stateName }}" data-controlled="{{ checked is defined ? 'true' : 'false' }}">
    <button type="button" role="checkbox" data-slot="checkbox" class="acervo-checkbox__button {{ className|default('') }}" aria-checked="{{ stateName == 'indeterminate' ? 'mixed' : (stateName == 'checked' ? 'true' : 'false') }}"{% if id is defined %} id="{{ id }}"{% endif %}{% if label is defined %} aria-label="{{ label|trans }}"{% endif %}{% if disabled|default(false) %} disabled{% endif %}{% if required|default(false) %} aria-required="true"{% endif %}{% for key, attribute in attributes|default({}) %} {{ key }}="{{ attribute }}"{% endfor %}>
        {% block children %}{{ children|default('') }}{% endblock %}
        <svg class="acervo-checkbox__indicator" data-slot="checkbox-indicator" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3.5" stroke="currentColor" aria-hidden="true">
            <path class="acervo-checkbox__check" pathLength="1" stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            <line class="acervo-checkbox__mixed" pathLength="1" x1="5" y1="12" x2="19" y2="12" stroke-linecap="round"/>
        </svg>
    </button>
    <input class="acervo-checkbox__input" type="checkbox" tabindex="-1" aria-hidden="true"{% if name is defined %} name="{{ name }}"{% endif %} value="{{ value|default('on') }}"{% if form is defined %} form="{{ form }}"{% endif %}{% if stateName == 'checked' %} checked{% endif %}{% if disabled|default(false) %} disabled{% endif %}{% if required|default(false) %} required{% endif %}>
</span>
