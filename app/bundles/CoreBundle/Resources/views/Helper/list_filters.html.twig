{% if filters is defined and filters is not empty %}
    <div class="form-group">
        {% for filterName, filter in filters %}
        {% set attr = getFilterAttributes(
            filterName|trans,
            filter,
            target|default('.page-list'),
            tmpl|default('list')
        ) %}
        <select {{ attr|join(' ')|raw }}>
        {% if filter.groups is defined %}
            {% for groupLabel, groupFilter in filter.groups %}
                <optgroup label="{{ groupLabel|trans }}"{% if groupFilter.prefix is defined %} data-prefix="{{ groupFilter.prefix }}"{% endif %}>
                    {% if groupFilter.options is defined %}
                    {% for value, label in groupFilter.options %}
                        {% if label is iterable %}
                            {% set optionValue = label.value|default(label.alias|default(label.id)) %}
                            {% set label = label.label|default(label.title|default(label.alias|default(''))) %}
                        {% else %}
                            {% set optionValue = value %}
                            {% set label = label %}
                        {% endif %}

                        {% set selected = (groupFilter.values is defined and optionValue in groupFilter.values) ? ' selected' : '' %}

                        {% if groupFilter.prefix is defined %}
                            {% set optionValue = groupFilter.prefix ~ ':' ~ optionValue %}
                        {% endif %}
                    <option value="{{ optionValue|escape('html_attr') }}"{{ selected }}>{{ label }}</option>
                    {% endfor %}
                    {% endif %}
                </optgroup>
            {% endfor %}
        {% elseif filter.options is defined %}
            {% for value, label in filter.options %}
                {% if label is iterable %}
                    {% set optionValue = label.value|default(label.alias|default(label.id)) %}
                    {% set label = label.label|default(label.title|default(label.alias|default(''))) %}
                {% else %}
                    {% set optionValue = value %}
                    {% set label = label %}
                {% endif %}

                {% set selected = (filter.values is defined and optionValue in filter.values) ? ' selected' : '' %}
                <option value="{{ optionValue|escape('html_attr') }}"{{ selected }}>
                    {{ (filter.translateLabels is not defined or filter.translateLabels is empty) ? label|purify : label|trans }}
                </option>
            {% endfor %}
        {% endif %}
        </select>
        {% endfor %}
    </div>
{% endif %}
