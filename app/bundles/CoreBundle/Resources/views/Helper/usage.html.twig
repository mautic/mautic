{#
Variables
  - title
  - stats
  - noUsages
#}

{% if stats is defined and stats is not empty %}
    <div class="panel shd-none rounded-0 bdr-w-0 mt-12 mb-0">
        <div class="panel-heading">
            <div class="panel-title">{{- title -}}</div>
        </div>
        <div class="panel-body pt-5">
            {% set used = stats|filter(stat => stat.ids|length > 0) %}
            {% if used|length > 0 %}
                {% set items = [] %}
                {% for stat in used %}
                    {% set items = items|merge([{
                        'label': stat.label|trans,
                        'value': stat.ids|length,
                        'href': path(stat.route, {'search': 'mautic.core.searchcommand.ids'|trans~':'~stat.ids|sort|join(',')}),
                    }]) %}
                {% endfor %}
                {{ include('@MauticCore/Components/partition-bar.html.twig', {'items': items, 'variant': variant|default('legend')}) }}
            {% else %}
                <p class="text-secondary mb-0">
                    {{ noUsages|default('mautic.core.usage.not_found'|trans) }}
                </p>
            {% endif %}
        </div>
    </div>
{% endif %}
