{% macro generate_id(string) -%}
    {% set parts = string|split('.') %}
    {% set id_parts = parts|slice(-3) %}
    {{- id_parts|join('_')|lower|trim -}}
{%- endmacro %}

{% set accordionId = accordionId is defined ? accordionId : 'accordion' %}

<!-- Accordion -->
<ul class="accordion" id="{{ accordionId }}" role="tablist" aria-multiselectable="true">
    {%- for item in items -%}
    {%- set itemId = (item.id ?? _self.generate_id(item.title))|trim -%}
    {%- set padding_inline = item.padding_inline ?? true -%}
        <li class="panel">
            <button type="button" id="heading{{- itemId -}}" class="accordion-heading collapsed" data-bs-toggle="collapse" data-bs-target="#collapse{{- itemId -}}" aria-expanded="false" aria-controls="collapse{{- itemId -}}">
                <i class="ri-arrow-down-s-line accordion-arrow"></i>
                <span class="accordion-title">{{ item.title|trans }}</span>
            </button>
            <div id="collapse{{- itemId -}}" class="collapse accordion-wrapper" data-bs-parent="#{{ accordionId }}" role="tabpanel" aria-labelledby="heading{{- itemId -}}">
                <div class="accordion-content{% if not padding_inline %} accordion-content--slim{% endif %}">
                    {{- item.content|raw -}}
                </div>
            </div>
        </li>
    {%- endfor -%}
</ul>
