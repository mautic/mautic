{% set searchValue = searchValue|default('') %}
{% set target = target|default('.page-list') %}
{% set overlayTarget = overlayTarget|default(target) %}
{% set overlayEnabled = overlayDisabled is defined and overlayDisabled is not empty ? 'false' : 'true' %}
{% set id = searchId|default('list-search') %}
{% set tmpl = tmpl|default('list') %}
{% set scopeCommands = [] %}
{% if searchScopes is defined and searchScopes is not empty %}
    {% for scope in searchScopes %}
        {% if scope.disabled|default(false) is same as(false) %}
            {% set scopeCommands = scopeCommands|merge([scope.command|default('')]) %}
        {% endif %}
    {% endfor %}
    {% set parsedScope = search_scope_parse(searchValue, scopeCommands) %}
    {% set displaySearchValue = parsedScope.command ? parsedScope.value : searchValue %}
{% else %}
    {% set parsedScope = {'command': '', 'value': searchValue} %}
    {% set displaySearchValue = searchValue %}
{% endif %}

<div class="d-flex fg-1">
    {% if searchScopes is defined and searchScopes is not empty %}
        {{ include('@MauticCore/Helper/search_scope.html.twig', {
            id: id,
            searchValue: searchValue,
            searchScopes: searchScopes,
            searchScopeHint: searchScopeHint|default(null),
            scopeCommands: scopeCommands,
            parsedScope: parsedScope,
        }) }}
    {% endif %}
    {{ include('@MauticCore/Components/search-input.html.twig', {
        id: id,
        name: 'search',
        size: 'lg',
        value: displaySearchValue,
        placeholder: 'mautic.core.search.placeholder',
        wrapperClass: 'fg-1',
        attributes: {
            'class': 'search',
            'data-toggle': 'livesearch',
            'data-target': target,
            'data-tmpl': tmpl,
            'data-action': action|default(''),
            'data-overlay': overlayEnabled,
            'data-overlay-text': 'mautic.core.search.livesearch'|trans,
            'data-overlay-target': overlayTarget
        }
    }, with_context = false) }}
</div>
{% if (filters is defined and filters is not empty) or (quickFilters is defined and quickFilters is not empty) %}
{% set filtering %}
<div class="row">
    {% if quickFilters is defined and quickFilters is not empty %}
    <div class="{% if filters is defined and filters is not empty %}col-xs-6 pa-0{% endif %}">
        {{ include('@MauticCore/Helper/list_quickfilters.html.twig', {
            'quickFilters': quickFilters
        }) }}
    </div>
    {% endif %}
    {% if filters is defined and filters is not empty %}
    <div class="{{ quickFilters is defined and quickFilters is not empty ? 'col-xs-6' : 'col-xs-12' }} pa-0">
        <div class="dropdown-header mt-0">{{ filtersLabel|default('mautic.core.quick_filters.more')|trans }}</div>
        <div class="pi-md">
            {{- include('@MauticCore/Helper/list_filters.html.twig', {
                filters: filters,
                target: target|default(null),
                tmpl: tmpl|default(null)
            }) -}}
        </div>
    </div>
    {% endif %}
</div>
<div class="row">
    <div class="footer-buttons d-flex fw-nowrap gap-1 mt-lg">
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [
                {
                    label: 'mautic.core.reset_filter',
                    variant: 'secondary',
                    onclick: 'Mautic.resetFilters()',
                    size: 'lg'
                },
                {
                    label: 'mautic.core.apply_filter',
                    variant: 'primary',
                    onclick: 'Mautic.applyFilters()',
                    size: 'lg'
                }
            ]
        } %}
    </div>
</div>
{% endset %}

{% include '@MauticCore/Helper/button.html.twig' with {
    buttons: [
    {
        variant: 'ghost',
        icon_only: true,
        icon: 'ri-filter-line ri-1x',
        attributes: {
            'type': 'button',
            'data-container': 'body',
            'data-toggle': 'popover',
            'data-html': 'true',
            'data-placement': 'left',
            'data-content': filtering|escape('html_attr')
        },
        label: 'mautic.core.quick_filters'
    }
    ]
} %}
{% endif %}
