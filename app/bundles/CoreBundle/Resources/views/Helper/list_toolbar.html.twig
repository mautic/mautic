{% set wrap = true %}
{% set userColumnPrefs = userColumnPrefs|default([]) %}
{% set contactColPrefs = contactColPrefs|default([]) %}
{% set companyColPrefs = companyColPrefs|default([]) %}
{% set showColumnsButton = app.request.pathinfo starts with '/s/contacts'
    or app.request.pathinfo starts with '/s/companies'
    or app.request.pathinfo starts with '/s/emails' %}

<div class="panel-heading pa-0 toolbar--table-toolbar">

    <div class="toolbar--batch-actions d-flex jc-space-between bg-primary fd-column fd-row-sm">
        <div class="toolbar--batch-summary d-flex">
            <span class="toolbar--batch-summary__count" data-singular="{{
'mautic.core.item_selected'|trans|lower }}"
                  data-plural="{{ 'mautic.core.items_selected'|trans|lower }}">0 {{
'mautic.core.items_selected'|trans|lower }}</span>
        </div>
        <div class="toolbar--action-list d-flex fw-wrap fw-nowrap-sm">
            {{ include('@MauticCore/Helper/toolbar_bulk_actions.html.twig', bulk_actions|default({})) }}
            <span class="toolbar--batch-summary__divider">|</span>
            {% include '@MauticCore/Helper/button.html.twig' with {
                buttons: [
                    {
                        label: 'mautic.core.form.cancel',
                        variant: 'primary',
                        size: 'lg',
                        attributes: {
                            'type': 'button',
                            'class': 'bdr-rds-0',
                            'data-toggle': 'cancel-checkall'
                        }
                    }
                ]
            } %}
        </div>
    </div>

    <div class="d-flex ai-center list-toolbar toolbar--toolbar-content h-48">
        {% if searchValue is defined %}
            {{- include('@MauticCore/Helper/search.html.twig', {
                searchId: searchId|default(null),
                searchValue: searchValue,
                action: action|default(''),
                searchHelp: searchHelp|default(''),
                target: target|default(null),
                tmpl: tmpl|default(null),
                overlayDisabled: overlayDisabled is defined ? overlayDisabled : null
            }) -}}
        {% endif %}

        {# Existing toolbar actions #}
        {% include '@MauticCore/Helper/toolbar_actions.html.twig' %}
        {{ include('@MauticCore/Helper/toolbar_page_actions.html.twig', page_actions|default({})) }}

        {# Added Columns button #}
        {% if showColumnsButton %}
        <button
            type="button"
            class="btn btn-default ml-2"
            id="column-config-toggle"
            data-toggle="modal"
            data-target="#column-config-modal"
            title="{{ 'mautic.core.columns'|trans }}"
        >
            <i class="fa fa-columns"></i> {{ 'Columns'|trans }}
        </button>
        {% endif %}
    </div>

</div>

{% block scripts %}
    {{ parent() }}
    <script>
        window.userColumnPrefs = {{ userColumnPrefs|default([])|json_encode|raw }};
        window.contactColPrefs = {{ contactColPrefs|default([])|json_encode|raw }};
        window.companyColPrefs = {{ companyColPrefs|default([])|json_encode|raw }};
    </script>
{% endblock %}

{# Modal renderer #}
<script>
function renderColumnModal(config) {
  const existing = document.getElementById('column-config-modal');
  if (existing) existing.remove();

  const formHtml = config.allColumns.map(key => {
    const label = config.labels[key] || key;
    const isChecked = (window.userColumnPrefs || []).includes(key);
    return `
      <div class="form-check">
        <input class="form-check-input" type="checkbox" value="${key}" id="col-${key}" name="columns" ${isChecked ? 'checked' : ''}>
        <label class="form-check-label" for="col-${key}">${label}</label>
      </div>
    `;
  }).join('');

  const modalHtml = `
    <div class="modal" id="column-config-modal" tabindex="-1" role="dialog" aria-labelledby="columnConfigModalLabel" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content" tabindex="0">
          <div class="modal-header">
            <h5 class="modal-title" id="columnConfigModalLabel">Select Columns</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <form id="column-picker-form">${formHtml}</form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary" id="save-columns">Save changes</button>
          </div>
        </div>
      </div>
    </div>
  `;

  document.body.insertAdjacentHTML('beforeend', modalHtml);
}
</script>

<script>
  function setupColumnPreferences({
  preferenceKey,
  preferenceVar,
  columnPrefs,
  allColumns,
  tableSelector,
  columnPrefix,
  csrfToken
}) {
  const $ = window.mQuery;

  // Initial apply
  if (columnPrefs.length > 0) {
    window.applyColumnPrefs(columnPrefs, tableSelector, columnPrefix, allColumns);
    document.querySelectorAll('#column-picker-form input[type="checkbox"]').forEach(cb => {
      cb.checked = columnPrefs.includes(cb.value);
    });
  }

  // Save handler
  const saveButton = document.getElementById('save-columns');
  if (saveButton) {
    saveButton.addEventListener('click', function () {
      const selected = Array.from(document.querySelectorAll('#column-picker-form input:checked')).map(cb => cb.value);

      fetch('/s/user/set-preference', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          preference: preferenceKey,
          value: selected
        })
      }).then(response => {
        if (response.ok) {
          window[preferenceVar] = selected;
          window.applyColumnPrefs(selected, tableSelector, columnPrefix, allColumns);
          $('#column-config-modal').modal('hide');
        } else {
          alert('Failed to save column preferences.');
        }
      }).catch(err => {
        console.error('Error saving preferences:', err);
      });
    });
  }

  // Modal a11y handling
  $modal
    .on('hidden.bs.modal', function() {
      $('.modal-backdrop').remove();
      $('body').removeClass('modal-open');
      document.querySelectorAll('[aria-hidden="true"]').forEach(el =>
        el.removeAttribute('aria-hidden')
      );
    })
    .on('shown.bs.modal', function() {
      const modalContent = this.querySelector('.modal-content');
      modalContent.focus();
      document.querySelectorAll('body > *:not(#column-config-modal)').forEach(el => {
        el.setAttribute('aria-hidden', 'true');
      });
      this.removeAttribute('aria-hidden');
    });
}
</script>

<script>
function withjQuery(callback) {
  if (typeof window.jQuery !== 'undefined') {
    callback(window.jQuery);
  } else {
    const interval = setInterval(() => {
      if (typeof window.jQuery !== 'undefined') {
        clearInterval(interval);
        callback(window.jQuery);
      }
    }, 50);
  }
}

withjQuery(function($) {
  const path = window.location.pathname;

  // Loop through all defined columnConfigs
  Object.entries(columnConfigs).forEach(([route, tableConfig]) => {
    if (path.includes(route)) {
      // Try to get a matching prefs variable from window
      const prefsVar =
        tableConfig.preferenceVar && window[tableConfig.preferenceVar]
          ? window[tableConfig.preferenceVar]
          : [];

      renderColumnModal(tableConfig);

      setTimeout(() => {
        setupColumnPreferences({
          preferenceKey: tableConfig.preferenceKey,
          preferenceVar: tableConfig.preferenceVar,
          columnPrefs: prefsVar,
          allColumns: tableConfig.allColumns,
          tableSelector: tableConfig.tableSelector,
          columnPrefix: tableConfig.columnPrefix,
          csrfToken: window.csrfToken || ''
        });
      }, 0);
    }
  });
});
</script>
