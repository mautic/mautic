{% macro generateTabId(translationKey) -%}
    {%- set parts = translationKey|split('.') -%}
    {%- set lastParts = parts|slice(-2) -%}
    {{- lastParts|join('-')|lower -}}
{%- endmacro %}

{% macro tabContent(tab, tabId, isActive, variant) %}
    <div role="tabpanel"
         class="tab-pane {% if tab.className is defined and tab.className %} {{ tab.className }} {% endif %} fade{% if isActive %} in active{% endif %}{% if variant == 'contained' or variant == 'vertical' %} fg-1 layer-two{% endif %}"
         id="{{ tabId }}">
        {{ tab.content|raw }}
    </div>
{% endmacro %}

{% macro iconContent(tab, variant, isDismissable) %}
    {% if tab.renderIcon is defined and tab.renderIcon %}
        <i class="tabs__nav-item-icon fs-b-e{% if variant == 'line' and isDismissable %} mr-8{% elseif variant == 'line' %} ml-8{% elseif variant == 'contained' %} ml-12{% endif %} {{ tab.renderIcon }}"></i>
    {% endif %}
{% endmacro %}

{% macro tagContent(tab, variant, isDismissable) %}
    {% if tab.renderTag is defined and tab.renderTag %}
        {% set tagData = tab.renderTag|merge({'color': 'primary', 'size': 'sm'}) %}
        <div class="tabs__nav-item-tag{% if variant == 'line' and isDismissable %} mr-8{% elseif variant == 'line' %} ml-8{% elseif variant == 'contained' %} ml-12{% endif %}">
            {% include '@MauticCore/Helper/_tag.html.twig' with {'tags': [tagData]} %}
        </div>
    {% endif %}
{% endmacro %}

{% macro secondaryLabel(tab) %}
    {% if tab.secondaryLabel is defined and tab.secondaryLabel %}
        <div class="tabs__nav-item-secondary-label type-label-01" title="{{ tab.secondaryLabel }}">{{ tab.secondaryLabel }}</div>
    {% endif %}
{% endmacro %}

<div class="tabs-container{% if variant == 'vertical' %} tabs-container--vertical{% endif %}">
    {# Nav tabs #}
    <ul class="nav nav-tabs{% if variant == 'line' %} nav-tabs--line{% elseif variant == 'contained' %} nav-tabs--contained{% elseif variant == 'iconOnly' %} nav-tabs--line nav-tabs--icon-only{% elseif variant == 'vertical' %} nav-tabs--vertical nav-tabs--contained{% endif %} tab--list" role="tablist">
        {% for tab in tabs %}
            {%- set tabId = tab.id|default(_self.generateTabId(tab.label)) -%}
            {%- set isActive = (selectedIndex is defined and loop.index0 == selectedIndex) or (selectedIndex is not defined and loop.first) -%}
            <li role="presentation" class="{% if isActive %}active{% endif %}{% if tab.disabled is defined and tab.disabled %} disabled{% endif %}"{% if variant == 'iconOnly' %} data-toggle="tooltip" title="{{ tab.label|trans }}"{% endif %}>
                {% if variant == 'iconOnly' %}
                    <a href="#{{ tabId }}" aria-controls="{{ tabId }}" role="tab" data-toggle="tab" class="tabs__nav-item tabs__nav-item--icon-only {% if iconSize is defined and iconSize == 'lg' %}tabs__nav-item--icon-only__20{% endif %} tabs__nav-link">
                       <div class="tabs__nav-item-label-wrapper">
                           {% if tab.renderTag is defined and tab.renderTag %}
                               {{ _self.tagContent(tab, variant, false) }}
                           {% else %}
                               <i class="tabs__nav-item-icon {{ tab.renderIcon }}"></i>
                           {% endif %}
                       </div>
                    </a>
                {% elseif variant == 'vertical' %}
                    <a href="#{{ tabId }}" aria-controls="{{ tabId }}" role="tab" data-toggle="tab" class="tabs__nav-item tabs__nav-item--vertical {% if iconSize is defined and iconSize == 'lg' %}tabs__nav-item--icon-only__20{% endif %} tabs__nav-link">
                       <div class="tabs__nav-item-label-wrapper">
                           <span class="tabs__nav-item-label">{{ tab.label|trans }}</span>
                       </div>
                    </a>
                {% else %}
                    <a href="#{{ tabId }}" aria-controls="{{ tabId }}" role="tab" data-toggle="tab" class="tabs__nav-item tabs__nav-link">
                       <div class="tabs__nav-item-label-wrapper">
                            {% if isDismissable is defined and isDismissable %}
                                {% if tab.renderTag is defined and tab.renderTag %}
                                    {{ _self.tagContent(tab, variant, isDismissable|default(false)) }}
                                {% else %}
                                    {{ _self.iconContent(tab, variant, isDismissable|default(false)) }}
                                {% endif %}
                                <span class="tabs__nav-item-label">{{ tab.label|trans }}</span>
                            {% else %}
                                <span class="tabs__nav-item-label">{{ tab.label|trans }}</span>
                                {% if tab.renderTag is defined and tab.renderTag %}
                                    {{ _self.tagContent(tab, variant, isDismissable|default(false)) }}
                                {% else %}
                                    {{ _self.iconContent(tab, variant, isDismissable|default(false)) }}
                                {% endif %}
                            {% endif %}
                        </div>
                        {% if variant == 'contained' %}
                            {{ _self.secondaryLabel(tab) }}
                        {% endif %}
                    </a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {# Tab content #}
    <div class="tab-content{% if variant == 'contained' %} tab-content--contained{% endif %}{% if variant == 'vertical' %} tab-content--contained tab-content--vertical{% endif %}">
        {% for tab in tabs %}
            {%- set tabId = tab.id|default(_self.generateTabId(tab.label)) -%}
            {%- set isActive = (selectedIndex is defined and loop.index0 == selectedIndex) or (selectedIndex is not defined and loop.first) -%}
            {{ _self.tabContent(tab, tabId, isActive, variant) }}
        {% endfor %}
    </div>
</div>
