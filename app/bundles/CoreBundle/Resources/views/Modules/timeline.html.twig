<div class="timeline timeline-right">
    {% if header is defined and header is not empty %}
        <div class="header">
            {{ header|trans }}
        </div>
    {% endif %}
    
    <ul class="events">
        {% for event in events.events %}
            {% set icon = event.icon is defined ? event.icon : 'ri-history-line' %}
            {% set eventLabel = event.eventLabel is defined ? event.eventLabel : event.eventType %}
            {% if eventLabel is iterable %}
                {% set eventLabel %}
                  <a href="{{ eventLabel.href }}" target="_new">
                    {{- eventLabel.label|purify -}}
                  </a>
                {% endset %}
            {% endif %}

            {% set details = '' %}
            {% if event.contentTemplate is defined %}
                {% set details = include(event.contentTemplate, ignore_missing=true)|trim %}
            {% endif %}

            {% set wrapperClass = loop.index is odd ? 'wrapper' : 'wrapper' %}
            <li class="{{ wrapperClass }}">
                <div class="figure">
                    <i class="{{ icon }}"></i>
                </div>
                {% if details is not empty %}
                <button class="panel" data-toggle="popover" data-content="{{ details|e }}" data-html="true">
                {% else %}
                <div class="panel">
                {% endif %}
                    <div class="">
                        <h3 class="type-heading-01 mb-sm">{{ eventLabel }}</h3>
                        {% if event.eventDescription is defined %}
                        <div class="panel-meta">
                            <span class="event-description">{{ event.eventDescription }}</span>
                        </div>
                        {% endif %}
                        <div class="event-timestamp type-label-01 text-secondary mt-xs">
                            <span data-toggle="tooltip" title="{{ dateToFull(event.timestamp) }}">{{ dateToText(event.timestamp, 'local', true) }}</span>
                        </div>
                    </div>
                {% if details is not empty %}
                </button>
                {% else %}
                </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</div>
