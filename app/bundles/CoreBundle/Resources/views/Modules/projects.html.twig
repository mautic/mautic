
{# 
Variables
    - project {name, createdByUser, modifiedByUser, description, dateModified {date, timezone}}
#}
{% if item.projects is not empty %}
{% for project in item.projects %}

    {% set projectPopover %}
        <header class="project-popover__header mt-xs">
            <span class="project-popover__icon" aria-hidden="true"><i class="ri-archive-stack-line"></i></span>
            <h2 class="project-popover__title type-heading-03 text-interactive">{{ project.name }}</h2>
        </header>

        <div class="project-popover__meta mb-md">
            <span class="project-popover__meta-text type-label-01 text-secondary">Updated on {{ project.dateModified.date|date }}</span>
        </div>

        <p class="project-popover__description type-body-compact-01">
            {{ project.description|striptags|slice(0, 150) ~ (project.description|length > 150 ? '...' : '') }}
        </p>

        <div class="project-popover__actions">
            {% include '@MauticCore/Components/button.html.twig' with {
                buttons: [
                    {
                        label: 'View project',
                        href: path('mautic_project_action', {'objectAction': 'view', 'objectId': project.id}),
                        icon: 'ri-eye-line',
                        variant: 'tertiary',
                        attributes: {
                            class: 'project-popover__action'
                        }
                    },
                    {
                        label: 'Edit',
                        href: path('mautic_project_action', {'objectAction': 'edit', 'objectId': project.id}),
                        icon: 'ri-edit-line',
                        variant: 'tertiary',
                        attributes: {
                            class: 'project-popover__action'
                        }
                    }
                ]
            } %}
        </div>

        <footer class="project-popover__footer type-label-01 text-helper mt-32">
            <span class="project-popover__footer-icon" aria-hidden="true"><i class="ri-archive-line"></i></span>
            <span class="project-popover__footer-text">Project</span>
        </footer>

    {% endset %}

        <div class="project-popover" data-toggle="popover" data-content='{{ projectPopover }}' data-html="true" data-container="body" data-placement="bottom" data-trigger="hover" data-delay='{"show": 300, "hide": 2000}'>
            {% include '@MauticCore/Components/tag.html.twig' with {
                tags: [
                    {
                        label: project.name,
                        color: 'blue',
                        renderIcon: 'ri-archive-stack-line',
                    }
                ]
            } %}
        </div>

        {% endfor %}
    </span>
{% endif %}
