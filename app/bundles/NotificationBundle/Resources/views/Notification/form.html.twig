{#
  Variables
    - form
    - notification
    - forceTypeSelection (optional, bool, default=false)
        This will be defined when the notification entity is being edited
#}
{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}notification{% endblock %}

{% block headerTitle %}
  {% if notification.id %}
    {{ 'mautic.notification.header.edit'|trans({'%name%': notification.name}) }}
  {% else %}
    {{ 'mautic.notification.header.new'|trans }}
  {% endif %}
{% endblock %}

{% block content %}
{% set notificationTabContent %}
                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(form.name) }}
                                    {{ form_row(form.heading) }}
                                    {{ form_row(form.message) }}
                                    {{ form_row(form.url) }}
                                    {{ form_row(form.button) }}
                                </div>
                                <div class="col-md-6">
                                    {{ include('@MauticNotification/Notification/preview.html.twig', {
                                        'notification': notification,
                                    }, with_context=false) }}
                                </div>
                            </div>
{% endset %}
  {{ form_start(form) }}
    <div class="box-layout">
        <div class="col-md-9 height-auto">
            <div class="row">
                <div class="col-xs-12">
                    {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': [{'id': 'notification-container', 'label': 'mautic.notification.notification', 'content': notificationTabContent, 'className': 'bdr-w-0 pa-16'}], 'part': 'content'}) }}
                </div>
            </div>
        </div>
        <div class="col-md-3 height-auto bdr-l">
            <div class="pe-24 ps-24 pt-16 pb-16">
                {{ form_row(form.category) }}
                {{ form_row(form.language) }}
                <hr />
                {% include '@MauticCore/FormTheme/Fields/_utm_tags_fields.html.twig' %}
                <div class="hide">
                    {{ form_row(form.isPublished) }}
                    {{ form_row(form.publishUp) }}
                    {{ form_row(form.publishDown) }}
                    {{ form_rest(form) }}
                </div>
            </div>
        </div>
    </div>
  {{ form_end(form) }}
{% endblock %}
