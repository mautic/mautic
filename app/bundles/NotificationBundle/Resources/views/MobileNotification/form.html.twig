{#
  Variables
    - form
    - notification
    - integration (\Mautic\NotificationBundle\Integration\OneSignalIntegration)
    - forceTypeSelection (optional, bool, default = false)
        Only defined when editing notification
#}

{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}mobile_notification{% endblock %}

{% block headerTitle %}
  {% if notification.id %}
    {{ 'mautic.notification.mobile.header.edit'|trans({'%name%': notification.name}) }}
  {% else %}
    {{ 'mautic.notification.mobile.header.new'|trans }}
  {% endif %}
{% endblock %}

{% block content %}
  {% set integrationSettings = integration.integrationSettings.featureSettings %}
  {{ form_start(form) }}
  <div class="box-layout">
      <div class="col-md-9 height-auto">
          <div class="row">
              <div class="col-xs-12">
                  {% set notificationContent %}
                      <div class="row">
                          <div class="col-md-6">
                              {{- form_row(form.name) -}}
                              {{- form_row(form.heading) -}}
                              {{- form_row(form.url) -}}
                          </div>
                          <div class="col-md-6">{{ form_row(form.message) }}</div>
                      </div>
                  {% endset %}

                  {% set dataContent %}
                      <div class="row">
                          <div class="col-md-6">{{ form_row(form.mobileSettings.additional_data) }}</div>
                      </div>
                  {% endset %}

                  {% set tabs = [
                      {
                          'label': 'mautic.core.details',
                          'id': 'notification-container',
                          'content': notificationContent,
                          'className': 'bdr-w-0 pa-md'
                      },
                      {
                          'label': 'mautic.notification.tab.data',
                          'id': 'data-notification-container',
                          'content': dataContent,
                          'className': 'bdr-w-0 pa-md'
                      }
                  ] %}

                  {% if integrationSettings.platforms is defined and 'ios' in integrationSettings.platforms %}
                      {% set tabs = tabs|merge([
                          {
                              'label': 'mautic.notification.tab.ios',
                              'id': 'ios-notification-container',
                              'content': include('@MauticNotification/MobileNotification/_ios_notification_content.html.twig', {
                                  'form': form,
                                  'integrationSettings': integrationSettings
                              }),
                              'className': 'bdr-w-0 pa-md'
                          }
                      ]) %}
                  {% endif %}

                  {% if integrationSettings.platforms is defined and 'android' in integrationSettings.platforms %}
                      {% set tabs = tabs|merge([
                          {
                              'label': 'mautic.notification.tab.android',
                              'id': 'android-notification-container',
                              'content': include('@MauticNotification/MobileNotification/_android_notification_content.html.twig', {
                                  'form': form,
                                  'integrationSettings': integrationSettings
                              }),
                              'className': 'bdr-w-0 pa-md'
                          }
                      ]) %}
                  {% endif %}

                  <div class="pa-md">
                      {{ include('@MauticCore/Helper/nav_tabs.html.twig', {
                          'tabs': tabs,
                          'variant': 'contained',
                          'selectedIndex': 0
                      }) }}
                  </div>
              </div>
          </div>
      </div>
      <div class="col-md-3 height-auto bdr-l">
          <div class="pr-lg pl-lg pt-md pb-md">
              {{ form_row(form.category) }}
              {{ form_row(form.language) }}
              <hr />
              {% include '@MauticCore/FormTheme/Fields/_utm_tags_fields.html.twig' %}
              <div class="hide">
                  {{ form_row(form.isPublished) }}
                  {{ form_row(form.publishUp) }}
                  {{ form_row(form.publishDown) }}
                  {{ form_rest(form) }}
              </div>
          </div>
      </div>
  </div>
  {{ form_end(form) }}
{% endblock %}
