{% extends app.request.xmlHttpRequest ? '@MauticCore/Default/content.html.twig' : '@MauticUser/Security/base.html.twig' %}
{% block header %}{% trans %}mautic.user.auth.header{% endtrans %}{% endblock %}
{% block headerTitle %}{% trans %}mautic.user.auth.expired.header{% endtrans %}{% endblock %}

{% block content %}
    {% if app.request.xmlHttpRequest %}
        <div class="row">
            <div class="col-xs-12 col-sm-8 col-md-6 inline-login">
                {{ block('mainContent') }}
            </div>
        </div>
    {% else %}
        {{ block('mainContent') }}
    {% endif %}
{% endblock %}

{% block mainContent %}
		{% if not app.request.xmlHttpRequest %}
		<div class="mb-32 ps-16 pe-16 pt-16">
			<h1 class="type-fluid-paragraph-01">{% trans %}mautic.user.auth.header{% endtrans %}</h1>
			<span class="text-secondary type-helper-text-01">{{ 'mautic.user.auth.help'|trans }}</span>
		</div>
		{% endif %}
		{% if oidcSettings is defined and oidcSettings.isEnabled and oidcSettings.isRequired %}
			{% include '@MauticUser/Security/oidc_login_top.html.twig' with {parameters: oidcSettings} %}
		{% endif %}
		<form class="login-form bdr-t" name="login" data-toggle="ajax" role="form" action="{{ path('mautic_user_logincheck') }}" method="post">
		{% include '@MauticCore/Components/text-input.html.twig' with {
			variant: 'fluid',
			id: 'username',
			name: '_username',
			labelText: 'mautic.user.auth.form.loginusername',
			value: last_username|default(''),
			wrapperClass: 'form-group',
			attributes: {required: 'required', autofocus: 'autofocus'}
		} only %}
		{% include '@MauticCore/Components/password-input.html.twig' with {
			variant: 'fluid',
			id: 'password',
			name: '_password',
			labelText: 'mautic.core.password',
			wrapperClass: 'form-group mb-16',
			link: {href: path('mautic_user_passwordreset'), label: 'mautic.user.user.passwordreset.link'},
			attributes: {required: 'required'}
		} only %}
		<div class="pull-left mb-md ps-16">
			{% include '@MauticCore/Components/checkbox.html.twig' with {
				inline: true,
				items: [{ id: 'remember_me', name: '_remember_me', value: 'on', label: 'mautic.user.auth.form.rememberme' }]
			} only %}
		</div>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate')|escape }}"/>
		<div class="mt-24 row-no-gutters justify-content-end">
			<div class="col-xs-6">
				{% include '@MauticCore/Helper/button.html.twig' with {
					buttons: [{
						label: 'mautic.user.auth.form.loginbtn',
						variant: 'primary',
						size: 'xl',
						wide: true,
						icon: 'ri-arrow-right-line',
						attributes: {type: 'submit', id: 'form-loginbtn'}
					}]
				} only %}
			</div>
		</div>
	</form>
	{% if integrations is not empty %}
		<ul class="list-group">
			{% for sso in integrations %}
				<a href="{{ path('mautic_sso_login', {'integration' : sso.getName()}) }}" class="list-group-item">
					<img class="pull-left mr-xs" style="height: 16px;" src="{{ getAssetUrl(sso.getIcon()) }}">
					<p class="list-group-item-heading">{{ ('mautic.integration.sso.' ~ sso.getName())|trans }}</p>
				</a>
			{% endfor %}
		</ul>
	{% endif %}
	{% if oidcSettings is defined and oidcSettings.isEnabled %}
		{% include '@MauticUser/Security/oidc_login_bottom.html.twig' with {parameters: oidcSettings} %}
	{% endif %}
{% endblock %}
