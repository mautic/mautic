{#
    Renders the "Change password" button, its error summary and the change-password modal.
    Expects: passwordForm (the plainPassword form view), saveWarningContent and stagedMessage (translation keys).
#}
{% set passwordFieldErrorCount = passwordForm.vars.errors|length + passwordForm.password.vars.errors|length + passwordForm.confirm.vars.errors|length %}

{{ include('@MauticCore/Notification/inline_notification.html.twig', {
    'title': 'mautic.user.config.account.password.save.warning.title',
    'content': saveWarningContent,
    'alert_type': 'warning',
    'dismissible': false,
}) }}
{% include '@MauticCore/Helper/button.html.twig' with {
    buttons: [
        {
            label: 'mautic.user.config.account.password.change',
            variant: 'secondary',
            danger: passwordFieldErrorCount > 0,
            size: 'sm',
            icon: 'ri-lock-fill',
            attributes: {
                'type': 'button',
                'data-toggle': 'modal',
                'data-target': '#changePasswordModal',
            }
        }
    ]
} %}
{% if passwordFieldErrorCount > 0 %}
    <div class="alert alert-danger mt-xs mb-0">
        {{ form_errors(passwordForm) }}
        {{ form_errors(passwordForm.password) }}
        {{ form_errors(passwordForm.confirm) }}
    </div>
{% endif %}

{% set changePasswordModalContent %}
    {{ include('@MauticCore/Notification/inline_notification.html.twig', {
        'title': 'mautic.user.config.account.password.save.warning.modal.title',
        'content': saveWarningContent,
        'alert_type': 'warning',
        'dismissible': false,
    }) }}
    {{ form_row(passwordForm.password) }}
    {{ form_row(passwordForm.confirm) }}
    <div id="passwordMismatchError" class="alert alert-danger mt-xs mb-0 hide"></div>
{% endset %}
{% set changePasswordModalAttributes = {'data-staged-message': stagedMessage} %}
{% if passwordFieldErrorCount > 0 %}
    {% set changePasswordModalAttributes = changePasswordModalAttributes|merge({'data-auto-open': 'true'}) %}
{% endif %}
{% include '@MauticCore/Components/modal.html.twig' with {
    id: 'changePasswordModal',
    modalHeading: 'mautic.user.config.account.password.change',
    modalContent: changePasswordModalContent,
    modalAttributes: changePasswordModalAttributes,
    buttons: [
        {
            label: 'mautic.core.form.done',
            variant: 'primary',
            attributes: {
                'type': 'button',
                'data-dismiss': 'modal',
            }
        }
    ]
} %}
