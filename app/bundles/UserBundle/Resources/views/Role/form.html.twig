{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}role{% endblock %}
{% do assetAddScriptDeclaration('MauticVars.permissionList = ' ~ (permissionsConfig['list']|json_encode), 'bodyClose') %}

{% set objectId = form.vars.data.getId() %}
{% if objectId is not empty %}
    {% set name = form.vars.data.getName() %}
    {% set header = 'mautic.user.role.header.edit'|trans({'%name%' : name}) %}
{% else %}
    {% set header = 'mautic.user.role.header.new'|trans %}
{% endif %}

{% block headerTitle %}{{ header }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="box-layout">
	<div class="col-xs-12 height-auto">
		{% set hidePerms = form.isAdmin.vars.data %}
		{% set detailsContent %}
				<div class="row">
					<div class="pa-16">
						<div class="col-md-6">
                            {{ form_row(form.name) }}
						</div>
						<div class="col-md-6">
                            {{ form_row(form.isAdmin) }}
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-md-6">
						<div class="pa-16">
                            {{ form_row(form.description) }}
						</div>
					</div>
				</div>
		{% endset %}
		{% set permissionTabs = [] %}
		{% set currentBundle = null %}
		{% set currentContent = '' %}
		{% for child in form.permissions.children %}
			{% if 'newbundle' == child.vars.value %}
				{% if currentBundle is not null %}
					{% set permissionTabs = permissionTabs|merge([{
						'id': currentBundle ~ 'PermissionTab',
						'label': permissionsConfig['config'][currentBundle]['label'],
						'labelSuffix': ' <span class="permission-ratio">(<span class="' ~ currentBundle ~ '_granted">' ~ permissionsConfig['config'][currentBundle]['ratio'][0] ~ '</span> / <span class="' ~ currentBundle ~ '_total">' ~ permissionsConfig['config'][currentBundle]['ratio'][1] ~ '</span>)</span>',
						'content': '<div class="pt-16 pe-16 ps-16 pb-16">' ~ currentContent ~ '</div>',
						'className': 'bdr-w-0'
					}]) %}
				{% endif %}
				{% set currentBundle = child.vars.name %}
				{% set currentContent = '' %}
				{% do child.setRendered() %}
			{% else %}
				{% set currentContent = currentContent ~ form_row(child) %}
			{% endif %}
		{% endfor %}
		{% if currentBundle is not null %}
			{% set permissionTabs = permissionTabs|merge([{
				'id': currentBundle ~ 'PermissionTab',
				'label': permissionsConfig['config'][currentBundle]['label'],
				'labelSuffix': ' <span class="permission-ratio">(<span class="' ~ currentBundle ~ '_granted">' ~ permissionsConfig['config'][currentBundle]['ratio'][0] ~ '</span> / <span class="' ~ currentBundle ~ '_total">' ~ permissionsConfig['config'][currentBundle]['ratio'][1] ~ '</span>)</span>',
				'content': '<div class="pt-16 pe-16 ps-16 pb-16">' ~ currentContent ~ '</div>',
				'className': 'bdr-w-0'
			}]) %}
		{% endif %}
		{% do form.permissions.setRendered() %}
		{% set permissionsContent %}
			<div id="rolePermissions"{% if hidePerms %} class="hide"{% endif %}>
				<div class="box-layout">
					<div class="col-md-5 height-auto">
						<div class="pe-24 ps-24 pt-16 pb-16">
							{{ include('@MauticCore/Components/tabs.html.twig', {'tabs': permissionTabs, 'variant': 'vertical', 'part': 'nav'}) }}
						</div>
					</div>
					<div class="col-md-7 height-auto bdr-l">
						{{ include('@MauticCore/Components/tabs.html.twig', {'tabs': permissionTabs, 'variant': 'vertical', 'part': 'content'}) }}
					</div>
				</div>
			</div>
			<div id="isAdminMessage"{% if not hidePerms %} class="hide"{% endif %}>
				<div class="alert alert-warning">
					<h4>{% trans %}mautic.user.role.permission.isadmin.header{% endtrans %}</h4>
					<p>{% trans %}mautic.user.role.permission.isadmin.message{% endtrans %}</p>
				</div>
			</div>
		{% endset %}
		{{ include('@MauticCore/Components/tabs.html.twig', {
			'variant': 'contained',
			'tabs': [
				{'id': 'details-container', 'label': 'mautic.core.details', 'content': detailsContent, 'className': 'pa-16'},
				{'id': 'permissions-container', 'label': 'mautic.user.role.permissions', 'content': permissionsContent, 'className': 'pa-16', 'itemAttributes': {'id': 'permissions-tab'}}
			]
		}) }}
	</div>
</div>
    {{ form_end(form) }}
{% endblock %}
