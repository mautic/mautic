{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}role{% endblock %}
{% do assetAddScriptDeclaration('MauticVars.permissionList = ' ~ (permissionsConfig['list']|json_encode), 'bodyClose') %}

{% set objectId = form.vars.data.getId() %}
{% if objectId is not empty %}
    {% set name = form.vars.data.getName() %}
    {% set header = 'mautic.user.role.header.edit'|trans({'%name%' : name}) %}
{% else %}
    {% set header = 'mautic.user.role.header.new'|trans %}
{% endif %}

{% block headerTitle %}{{ header }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    {% set hidePerms = form.isAdmin.vars.data %}
    {% set detailsContent %}
        <div class="row">
            <div class="pa-16">
                <div class="col-md-6">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.isAdmin) }}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="pa-16">
                    {{ form_row(form.description) }}
                </div>
            </div>
        </div>
    {% endset %}
    {% set permissionTabs = [] %}
    {% set currentBundle = null %}
    {% set currentContent = '' %}
    {% for child in form.permissions.children %}
        {% if 'newbundle' == child.vars.value %}
            {% if currentBundle is not null %}
                {% set permissionTabs = permissionTabs|merge([{
                    'id': currentBundle ~ 'PermissionTab',
                    'label': permissionsConfig['config'][currentBundle]['label'],
                    'content': '<div class="pt-16 pe-16 ps-16 pb-16">' ~ currentContent ~ '</div>',
                    'className': 'bdr-w-0'
                }]) %}
            {% endif %}
            {% set currentBundle = child.vars.name %}
            {% set currentContent = '' %}
            {% do child.setRendered() %}
        {% else %}
            {% set currentContent = currentContent ~ form_row(child) %}
        {% endif %}
    {% endfor %}
    {% if currentBundle is not null %}
        {% set permissionTabs = permissionTabs|merge([{
            'id': currentBundle ~ 'PermissionTab',
            'label': permissionsConfig['config'][currentBundle]['label'],
            'content': '<div class="pt-16 pe-16 ps-16 pb-16">' ~ currentContent ~ '</div>',
            'className': 'bdr-w-0'
        }]) %}
    {% endif %}
    {% do form.permissions.setRendered() %}
    {% set permissionsContent %}
        <div id="rolePermissions"{% if hidePerms %} class="hide"{% endif %}>
            {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': permissionTabs, 'variant': 'vertical'}) }}
        </div>
        <div id="isAdminMessage"{% if not hidePerms %} class="hide"{% endif %}>
            <div class="alert alert-warning">
                <h4>{% trans %}mautic.user.role.permission.isadmin.header{% endtrans %}</h4>
                <p>{% trans %}mautic.user.role.permission.isadmin.message{% endtrans %}</p>
            </div>
        </div>
    {% endset %}
    <div class="box-layout">
        <div class="col-xs-12 height-auto">
            {{ include('@MauticCore/Components/tabs.html.twig', {
                'tabs': [
                    {'id': 'details-container', 'label': 'mautic.core.details', 'content': detailsContent, 'className': 'pa-16 height-auto'},
                    {'id': 'permissions-container', 'label': 'mautic.user.role.permissions', 'content': permissionsContent, 'className': 'pa-16', 'attributes': {'id': 'permissions-tab'}}
                ],
                'variant': 'contained'
            }) }}
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
