includes:
    - phpstan-baseline.neon
    - phpstan-model-param-type-ignore.neon

parameters:
    tmpDir: ./var/phpstan-cache
    level: 6

    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    # see https://github.com/tomasVotruba/type-coverage
    type_coverage:
        return: 93.0
        param: 83.3
        property: 75.4
        constant: 99.9
    type_perfect:
        no_param_type_removal: true
        no_isset_on_object: true
        no_empty_on_object: true
        narrow_return: true
        narrow_param: true
        no_mixed_property: true
        no_mixed_caller: true

    symplify:
        naming: false
        complexity: true
        configurable: true
        static: true
        modern: false
        symfony: true
        symfonyConfig: true
        doctrine: true
        collections: true
        phpunit: true
        mocks: true
        ctor: true
        symfonyReturnType: true
        laravelReturnType: true
        pathStrings: true

    paths:
        - app/bundles
        - app/config
        - app/migrations
        - plugins
        - utils
    excludePaths:
        - *.js.php
        - *.less.php
        - *.inc.php
        - plugins/*/node_modules/*
        - plugins/*/vendor/*
        - */Fixture/*
        - */Source/*
        # @todo handle once the other PRs are merged
        - app/bundles/CoreBundle/Controller/AbstractStandardFormController.php
    dynamicConstantNames:
        - MAUTIC_ENV
        - MAUTIC_TABLE_PREFIX
        - MAUTIC_VERSION
    bootstrapFiles:
        - phpstan-bootstrap.php
    ignoreErrors:
        # newly enabled sets flag existing code wholesale, ignored for now to land the bump; fixed incrementally in follow-ups
        -
            identifiers:
                - doctrine.noEntityMocking
                - phpunit.noDocumentMocking
                - phpunit.noMockObjectAndRealObjectProperty
                - method.notFound
                - symplify.forbiddenFuncCall
                - symplify.forbiddenArrayMethodCall
                - symplify.forbiddenStaticClassConstFetch
                - symplify.newOverSetters
                - symplify.noArrayMapWithArrayCallable
                - symfony.noListenerWithoutContract
                - symfony.noFindTaggedServiceIdsCall
#                - return.unusedType
#                - property.unusedType
#                - assign.propertyType

        # type-perfect no_mixed_caller: rule enabled, violations typed incrementally; ignored wholesale for now
        -
            identifier: typePerfect.noMixedMethodCaller
            paths:
                - app/config
                - app/bundles
                - plugins

        # final classes mocked in tests make the Class&MockObject intersection unresolvable, the mock works via dg/bypass-finals
        -
            identifiers:
                - property.unresolvableType
                - property.unresolvableNativeType
                - varTag.unresolvableType
                - return.unresolvableType
                - argument.unresolvableType
                - method.unresolvableReturnType
            paths:
                - */Tests/*
                - */Test/*

        -
            identifier: argument.type
            path: app/bundles/CoreBundle/Controller/AjaxController.php

        # page translation entity passed where concrete Page expected in builder tokens
        -
            identifier: argument.type
            path: app/bundles/PageBundle/EventListener/BuilderSubscriber.php

        # shared translation/variant traits are typed against the concrete entity, interface-typed callers trip covariance
        -
            identifiers:
                - offsetAssign.valueType
                - argument.type
                - assign.propertyType
            paths:
                - app/bundles/CoreBundle/Entity/TranslationEntityTrait.php
                - app/bundles/CoreBundle/Entity/VariantEntityTrait.php

        # event-log API passes a LeadEventLog where the model expects an Event, kept as-is for now
        -
            identifiers:
                - argument.type
                - method.notFound
            path: app/bundles/CampaignBundle/Controller/Api/EventLogApiController.php

        # ReportGenerator keeps a nullable form factory for its lazy build flow
        -
            identifier: symplify.noNullableServiceInConstructor
            path: app/bundles/ReportBundle/Generator/ReportGenerator.php
        # the concrete Config Loader and Messenger TransportFactory are the ones wired as services, no interface alias exists
        -
            identifier: symplify.preferInterfaceInConstructor
            paths:
                - app/bundles/CoreBundle/Event/RouteEvent.php
                - app/bundles/MessengerBundle/Validator/DsnValidator.php
        # dynamic stdClass data (json_decode, imap, maxmind, search-filter trees) - mixed property fetch is inherent
        -
            identifier: typePerfect.noMixedPropertyFetcher
            paths:
                - plugins/MauticSocialBundle/Integration/FoursquareIntegration.php
                - plugins/MauticSocialBundle/Integration/InstagramIntegration.php
                - app/bundles/CoreBundle/Entity/CommonRepository.php
                - app/bundles/CoreBundle/Event/AbstractCustomRequestEvent.php
                - app/bundles/CoreBundle/Helper/PRedisConnectionHelper.php
                - app/bundles/CoreBundle/Helper/SearchStringHelper.php
                - app/bundles/CoreBundle/IpLookup/AbstractMaxmindLookup.php
                - app/bundles/CoreBundle/IpLookup/GeoipsLookup.php
                - app/bundles/CoreBundle/Tests/Unit/Helper/SearchStringHelperTest.php
                - app/bundles/EmailBundle/MonitoredEmail/Mailbox.php
                - app/bundles/PluginBundle/Integration/AbstractIntegration.php

        # Loader interface, concrete routing loader provides import()
        -
            identifier: method.notFound
            path: app/bundles/CoreBundle/Event/RouteEvent.php

        # stdClass search-filter tree built by SearchStringHelper
        -
            identifiers:
                - function.impossibleType
                - isset.offset
            path: app/bundles/CoreBundle/Entity/CommonRepository.php

        # these services have no class name alias in the container, so only the string name can fetch them
        -
            identifier: mautic.noContainerGet
            paths:
                - app/bundles/CoreBundle/Tests/Functional/DependencyInjection/AbstractContainerSmokeTestCase.php
                - app/bundles/CoreBundle/Tests/Functional/RouteMapTest.php
                - app/bundles/CoreBundle/Tests/Functional/Doctrine/Paginator/SimplePaginatorTest.php
                - app/bundles/CoreBundle/Tests/Functional/Service/LocalFileAdapterServiceTest.php
                - app/bundles/LeadBundle/Tests/Model/FieldModelTest.php
                - app/bundles/PageBundle/Tests/EventListener/PreferencePageTest.php
                - app/bundles/UserBundle/Tests/Controller/LoginUserWithSamlTrait.php

        # shared pre/post events, Campaign same-string collisions and TOKEN_REPLACEMENT reuse block single-argument dispatch here
        -
            identifier: mautic.singleArgumentDispatch
            paths:
                - app/bundles/CampaignBundle/Executioner/Dispatcher/DecisionDispatcher.php
                - app/bundles/ChannelBundle/Tests/EventListener/CampaignSubscriberTest.php
                - app/bundles/FormBundle/Tests/EventListener/CampaignSubscriberFunctionalTest.php
                - app/bundles/LeadBundle/Tests/EventListener/CampaignSubscriberFunctionalTest.php
                - app/bundles/NotificationBundle/EventListener/CampaignSubscriber.php
                - app/bundles/SmsBundle/Model/SmsModel.php
                - plugins/MauticFocusBundle/Model/FocusModel.php

        - identifier: missingType.generics
        # controllers - group missing parameter types to fix later

        -
            identifier: missingType.parameter
            path: *Controller.php
        # not all IDEs are as smart as PHPSTAN and need the type hint
        - identifier: function.alreadyNarrowedType
        - identifier: instanceof.alwaysTrue
        - '/Variable \$\w+ might not be defined\./'
        # test on purpose
        - '#Call to method PHPUnit\\Framework\\Assert::assertIsClosedResource\(\) with resource will always evaluate to true#'
        # handle later - ideally with custom interface
        -
            message: '#Call to an undefined method Mautic(.*?)Integration::getApiUrl\(\)#'
            path: plugins/*/Api/*
        - '#Parameter \$integration of method MauticPlugin\\MauticEmailMarketingBundle\\Api\\EmailMarketingApi::__construct\(\) has typehint with deprecated class Mautic\\PluginBundle\\Integration\\AbstractIntegration#'
        # Doctrine expects concrete types but traits use interfaces with generics
        -
            message: '#Property .+::\$translationParent type mapping mismatch: property can contain .+TranslationEntityInterface\|null but database expects#'
            path: app/bundles/CoreBundle/Entity/TranslationEntityTrait.php
            identifier: doctrine.associationType
        -
            message: '#Property .+::\$translationChildren type mapping mismatch: property can contain .+but database expects#'
            path: app/bundles/CoreBundle/Entity/TranslationEntityTrait.php
            identifier: doctrine.associationType

        -
            message: '#Property .+::\$variantParent type mapping mismatch: property can contain .+VariantEntityInterface\|null but database expects#'
            path: app/bundles/CoreBundle/Entity/VariantEntityTrait.php
            identifier: doctrine.associationType
        # oAuth2 entities redeclare FOS parent properties whose declared types (interfaces, int) differ from the concrete Doctrine mapping
        -
            message: '#Property .+::\$(client|user) type mapping mismatch: property can contain .+but database expects#'
            path: app/bundles/ApiBundle/Entity/oAuth2/*.php
            identifier: doctrine.associationType

        # mocks
        - '#is not subtype of native type PHPUnit\\Framework\\MockObject\\MockObject#'
        - '#Call to an undefined method PHPUnit\\Framework\\MockObject\\MockObject#'
        - '#expects (.*?) PHPUnit\\Framework\\MockObject\\MockObject given#'

        # on purpose type check
        -
            message: '#Parameter \#1 \$credentials of method Mautic\\IntegrationsBundle\\Auth\\Provider\\(.*?)::getClient\(\) expect#'
            paths:
                 - app/bundles/IntegrationsBundle/Tests/Unit/Auth/Provider/ApiKey/HttpFactoryTest.php
                 - app/bundles/IntegrationsBundle/Tests/Unit/Auth/Provider/Oauth2TwoLegged/HttpFactoryTest.php
        -
            message: '#Call to an undefined method Mautic\\IntegrationsBundle\\Auth\\Provider\\AuthCredentialsInterface::#'
            path: app/bundles/IntegrationsBundle/Auth/Provider/Oauth2ThreeLegged/HttpFactory.php
        # getClient takes the generic AuthCredentialsInterface, private helpers keep the concrete one for its getters
        -
            identifier: typePerfect.narrowPrivateClassMethodParamType
            paths:
                - app/bundles/IntegrationsBundle/Auth/Provider/BasicAuth/HttpFactory.php
                - app/bundles/IntegrationsBundle/Auth/Provider/Oauth1aTwoLegged/HttpFactory.php

        # deprecation
        -
            identifier: return.deprecatedClass
            path: app/bundles/IntegrationsBundle/Tests/Unit/AbstractIntegrationTest.php

        -
            identifier: class.extendsDeprecatedClass
            path: app/bundles/IntegrationsBundle/Tests/Unit/AbstractIntegrationTest.php
        # false positive, reflection reference method call
        -
            identifier: method.impossibleType
            paths:
                - app/bundles/LeadBundle/Tests/Entity/LeadRepositoryTest.php
                - app/bundles/NotificationBundle/Tests/Unit/Api/OneSignalApiTest.php
        -
            identifier: method.alreadyNarrowedType
            paths:
                - app/bundles/LeadBundle/Tests/Entity/LeadRepositoryTest.php
        # exception handler as both handler and standalone method
        -
            identifier: argument.type
            path: app/bundles/CoreBundle/ErrorHandler/ErrorHandler.php
        # handle after native type declarations are covered
        -
            identifier: missingType.iterableValue
            paths:
                - app
                - plugins

        # mautic deprecations
        -
            identifier: parameter.deprecatedClass
            message: '#class\s+Mautic#'
        -
            identifier: property.deprecatedClass
            message: '#class\s+Mautic#'
        -
            identifier: class.extendsDeprecatedClass
            message: '#class\s+Mautic#'
        -
            identifier: method.deprecatedClass
            message: '#class\s+Mautic#'
        -
            identifier: method.deprecated
            message: '#class\s+Mautic#'
        -
            identifier: return.deprecatedClass
            message: '#class\s+Mautic#'
        -
            identifier: classConstant.deprecatedClass
            message: '#class\s+Mautic#'

        # child class generic
        -
            message: '#Call to an undefined method TApiHelper of MauticPlugin\\MauticCrmBundle\\Api\\CrmApi::getLeads\(\)#'
            path: plugins/MauticCrmBundle/Integration/CrmAbstractIntegration.php

        -
            identifier: mautic.noTablePrefixDefinitionInTests
            path: app/bundles/CoreBundle/Test/EventListener/MaintenanceSubscriberTest.php

        # not useful, rather pedantic from phsptan-* extensions
        -
            identifier: argument.templateType
            path: app/bundles/CoreBundle/Helper/CookieHelper.php
            count: 1
        # repository is resolved from a dynamic entity class name
        -
            identifier: argument.templateType
            paths:
                - app/bundles/CoreBundle/EventListener/CommonStatsSubscriber.php
                - app/bundles/LeadBundle/Form/DataTransformer/TagEntityModelTransformer.php
        -
            message: '#Method MauticPlugin\\GrapesJsBuilderBundle\\Entity\\GrapesJsBuilderRepository@anonymous/plugins/GrapesJsBuilderBundle/Tests/Unit/Model/GrapesJsBuilderModelTest.php:\d+::findOneBy\(\) is marked as impure but does not have any side effects#'
            path: plugins/GrapesJsBuilderBundle/Tests/Unit/Model/GrapesJsBuilderModelTest.php
        # intentional, as overrides the property
        -
            identifier: symplify.noJustPropertyAssign
            path: app/bundles/ApiBundle/Serializer/Driver/ApiMetadataDriver.php

        # mixed return
        -
            identifier: return.unusedType
            message: '#Method Mautic(.*?)::getParameterValue\(\)#'
        # string operations
        -
            identifier: parameterByRef.type
            path: app/bundles/EmailBundle/Helper/PlainTextHelper.php
        # these are plugin-facing extension events: the carried service is exposed to third-party
        # listeners through a public getter, so removing it is a BC break to deprecate separately
        -
            identifier: mautic.noServiceInEventConstructor
            paths:
                - app/bundles/LeadBundle/Event/LeadListFilteringEvent.php
                - app/bundles/LeadBundle/Event/LeadListFiltersChoicesEvent.php

        # switch statements kept as-is, typed incrementally later
        -
            identifier: symplify.forbiddenSwitch
        # method_exists() is a legitimate runtime check for optional APIs, other forbidden funcs still flagged
        -
            identifier: symplify.forbiddenFuncCall
            message: '#Function "method_exists\(\)" cannot be used#'

        # permission classes mirror the parent constructor signature by design
        -
            identifier: symplify.noConstructorOverride
            paths:
                - */Permissions/*
                - app/bundles/CampaignBundle/Tests/Entity/EventFake.php
                - app/bundles/CoreBundle/Loader/RouteLoader.php

        # existing multi-arg dispatch sites, migrated to single-argument dispatch separately
        -
            identifier: symfony.singleArgEventDispatch
            paths:
                - app/bundles/CampaignBundle/Executioner/Dispatcher/ConditionDispatcher.php
                - app/bundles/CampaignBundle/Executioner/Dispatcher/DecisionDispatcher.php
                - app/bundles/CategoryBundle/Model/CategoryModel.php
                - app/bundles/ChannelBundle/Model/MessageModel.php
                - app/bundles/ChannelBundle/Tests/EventListener/CampaignSubscriberTest.php
                - app/bundles/DynamicContentBundle/Model/DynamicContentModel.php
                - app/bundles/FormBundle/Model/FieldModel.php
                - app/bundles/FormBundle/Model/FormModel.php
                - app/bundles/LeadBundle/Tests/EventListener/CampaignSubscriberFunctionalTest.php
                - app/bundles/NotificationBundle/EventListener/CampaignSubscriber.php
                - app/bundles/NotificationBundle/Model/NotificationModel.php
                - app/bundles/PageBundle/Model/PageModel.php
                - app/bundles/PointBundle/Model/PointGroupModel.php
                - app/bundles/PointBundle/Model/PointModel.php
                - app/bundles/PointBundle/Model/TriggerModel.php
                - app/bundles/ReportBundle/Model/ReportModel.php
                - app/bundles/SmsBundle/Model/SmsModel.php
                - app/bundles/StageBundle/Model/StageModel.php
                - plugins/MauticFocusBundle/Model/FocusModel.php

        # getRepository() used inside test helper traits to arrange fixtures, acceptable in test scope
        -
            identifier: doctrine.noGetRepositoryOutsideService
            paths:
                - app/bundles/CampaignBundle/Tests/Campaign/AbstractCampaignTestCase.php
                - app/bundles/CampaignBundle/Tests/CampaignAuditLogTrait.php
                - app/bundles/CampaignBundle/Tests/Functional/Campaign/CampaignEntitiesTrait.php
                - app/bundles/CoreBundle/Model/AbstractCommonModel.php
                - app/bundles/CoreBundle/Test/MauticMysqlTestCase.php

    scanDirectories:
        # the kernel boot reflects these classes, so PHPStan can no longer locate them by autoloading
        - vendor/lightsaml2/sp-bundle/src
        - vendor/lightsaml2/symfony-bridge/src
    scanFiles:
        # This is here because a few functions in the global namespace are defined in this file
        - vendor/twig/twig/src/Extension/EscaperExtension.php
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
        allowNullablePropertyForRequiredField: true
    symfony:
        containerXmlPath: var/cache/test/AppKernelTestDebugContainer.xml
        consoleApplicationLoader: app/console-application.php

rules:
    - Symplify\PHPStanRules\Rules\Complexity\NoJustPropertyAssignRule
    - Utils\PHPStan\Rule\AbstractClassNameMustBeAbstractRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoStringTargetEntityRule
    - Utils\PHPStan\Rule\NoTablePrefixDefinitionInTestsRule
    - Utils\PHPStan\Rule\AutowireMethodNameMustMatchClassRule
    - Utils\PHPStan\Rule\NoGetModelWithStringInControllerRule
    - Utils\PHPStan\Rule\NoRequiredMethodWithConstructorInControllerRule
    - Utils\PHPStan\Rule\NoGetRepositoryWithEntityRule
    - Utils\PHPStan\Rule\NoContainerGetRule
    - Utils\PHPStan\Rule\ControllerMethodMustReturnResponseRule
    - Utils\PHPStan\Rule\NoUnusedControllerActionParameterRule
    - Utils\PHPStan\Rule\NoUselessReferenceParamRule
    - Utils\PHPStan\Rule\NoUselessReferenceForeachRule

    - Symplify\PHPStanRules\Rules\Symfony\CommandMustHaveAsCommandAttributeRule
    - Symplify\PHPStanRules\Rules\Symfony\ConstraintMustHaveAttributeRule
    - Symplify\PHPStanRules\Rules\Symfony\NoNullableServiceInConstructorRule
    - Symplify\PHPStanRules\Rules\Symfony\PreferInterfaceInConstructorRule
    - Symplify\PHPStanRules\Rules\Complexity\NoPropertyToPropertyAssignRule

    - Utils\PHPStan\Rule\NoServicesInBundleConfigRule
    - Utils\PHPStan\Rule\NoServiceInMethodParameterRule
    - Utils\PHPStan\Rule\NoUnusedServiceAliasRule
    - Utils\PHPStan\Rule\NoParentConstructorForwardingRule
    - Symplify\PHPStanRules\Rules\Symfony\NoServiceJugglingRule
    - Utils\PHPStan\Rule\NoUnusedServiceNameRule
    - Utils\PHPStan\Rule\NoClassNameServiceAliasRule
    - Symplify\PHPStanRules\Rules\Symfony\ConfigClosure\NoAutoconfiguredServiceTagRule
    - Symplify\PHPStanRules\Rules\Symfony\ConfigClosure\PreferClassServiceReferenceRule
    - Symplify\PHPStanRules\Rules\Symfony\ConfigClosure\NoServiceSetterCallRule
    - Utils\PHPStan\Rule\NoServiceGetterRule
    - Symplify\PHPStanRules\Rules\Doctrine\NoReadonlyEntityClassRule
    - Utils\PHPStan\Rule\ModelMethodSingleParamMustHaveTypeRule
    - Symplify\PHPStanRules\Rules\RequireArrayShapeReturnRule
    - Utils\PHPStan\Rule\GenericTraitUseMustHaveGenericDocblockRule
    - Utils\PHPStan\Rule\BigIntIdParamMustBeIntOrStringRule
    - Utils\PHPStan\Rule\ControllerBigIntIdParamByNameRule
    - Utils\PHPStan\Rule\NoServiceInEventConstructorRule
    - Utils\PHPStan\Rule\SingleArgumentDispatchRule

services:
    - Utils\PHPStan\ServiceNameUsageResolver
    -
        class: Utils\PHPStan\Rule\ParamTypeByVariableNameRule
        tags:
            - phpstan.rules.rule
        arguments:
            variableNameToType:
                parameters: array
    -
        class: Utils\PHPStan\Rule\NullableObjectPropertyMustHaveNativeTypeRule
        tags:
            - phpstan.rules.rule
    -
        class: Utils\PHPStan\Type\ConnectionQueryBuilderReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: Utils\PHPStan\Collector\ByReferenceParamCollector
        tags:
            - phpstan.collector
    -
        class: Utils\PHPStan\Collector\ClassNameServiceAliasCollector
        tags:
            - phpstan.collector
    -
        class: Utils\PHPStan\Collector\ServiceAliasCollector
        tags:
            - phpstan.collector
    -
        class: Utils\PHPStan\Collector\ServiceDefinitionFetchCollector
        tags:
            - phpstan.collector
    -
        class: Utils\PHPStan\Collector\ServiceDefinitionNameCollector
        tags:
            - phpstan.collector
    -
        class: Utils\PHPStan\Collector\ServiceNameUsageCollector
        tags:
            - phpstan.collector
    -
        class: Symplify\PHPStanRules\Collector\ClassTargetServiceAliasCollector
        tags:
            - phpstan.collector
    -
        class: Symplify\PHPStanRules\Collector\ServiceStringReferenceCollector
        tags:
            - phpstan.collector
