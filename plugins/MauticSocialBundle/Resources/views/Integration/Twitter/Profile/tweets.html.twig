<ul class="list-group">
     {% for item in activity %}
        {% set border = 'border-bottom border-start-0 border-end-0' %}
        {% if loop.first or loop.last %}{% set border = 'border-0' %}{% endif %}
        <li class="{{ border }} pa-15 list-group-item">
            <p>{{ item.tweet }}</p>
            <span class="text-secondary"><i class="ri-time-line"></i> {{ dateToFull(item.published) }}</span>
        </li>
    {% endfor %}
</ul>
