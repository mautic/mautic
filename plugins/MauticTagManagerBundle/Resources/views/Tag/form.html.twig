{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}tagmanager{% endblock %}
{% set id = form.vars['data'].getId() %}

{% set header = id is empty ? 'mautic.tagmanager.menu.new'|trans : 'mautic.tagmanager.menu.edit'|trans({'%name%': entity.getTag()|trans}) %}
{% block headerTitle %} {{ header }} {% endblock %}

{% block content %}
    {{- form_start(form) -}}
    <div class="box-layout">
        <div class="col-md-9 height-auto">
            <div class="row">
                <div class="col-xs-12">
                    {% set tabsviewsform = [] %}
                    {% set tabsviewsformContent0 %}
                                                <div class="row">
                                                    <div class="col-xs-12">
                                                        {{- form_row(form.tag) -}}
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-xs-12">
                                                        {{ form_row(form.description) }}
                                                    </div>
                                                </div>

                    {% endset %}
                    {% set tabsviewsform = tabsviewsform|merge([{'id': 'details', 'label': 'mautic.core.details', 'content': tabsviewsformContent0, 'className': 'pa-16'}]) %}
                    {{ include('@MauticCore/Components/tabs.html.twig', {'tabs': tabsviewsform, 'variant': 'contained'}) }}

                </div>
            </div>
        </div>
    </div>
    {{- form_end(form) -}}
{% endblock %}
