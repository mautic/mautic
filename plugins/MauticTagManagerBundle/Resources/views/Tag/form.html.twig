{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}tagmanager{% endblock %}
{% set id = form.vars['data'].getId() %}

{% set header = id is empty ? 'mautic.tagmanager.menu.new'|trans : 'mautic.tagmanager.menu.edit'|trans({'%name%': entity.getTag()|trans}) %}
{% block headerTitle %} {{ header }} {% endblock %}

{% block content %}
    {{- form_start(form) -}}
    <div class="box-layout">
        <div class="col-md-9 height-auto">
            <div class="row">
                <div class="col-xs-12">
                    {% set detailsContent %}
                        <div class="row">
                            <div class="col-xs-12">
                                {{- form_row(form.tag) -}}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-12">
                                {{ form_row(form.description) }}
                            </div>
                        </div>
                    {% endset %}

                    {% set tabs = [
                        {
                            'label': 'mautic.core.details',
                            'id': 'details',
                            'content': detailsContent,
                            'className': 'bdr-w-0 pa-md'
                        }
                    ] %}

                    {{ include('@MauticCore/Helper/nav_tabs.html.twig', {
                        'tabs': tabs,
                        'variant': 'contained',
                        'selectedIndex': 0
                    }) }}
                </div>
            </div>
        </div>
    </div>
    {{- form_end(form) -}}
{% endblock %}
