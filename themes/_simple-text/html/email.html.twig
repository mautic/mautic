<mjml>
    <mj-head>
      <!-- CSS-STYLE -->
      <mj-style inline="inline"> p, li {margin:0 !important; padding:0; line-height:140%;}
      </mj-style>
      <mj-attributes>
        <mj-all font-family="Ubuntu, Helvetica, Arial, sans-serif"></mj-all>
        <mj-text mj-class="t-body"></mj-text>
        <mj-button border-radius="3px" padding="10px 25px"></mj-button>
        <mj-section></mj-section>

        <mj-class name="t-body" font-size="16px"></mj-class>
        <mj-class name="t-btn" inner-padding="16px 32px"></mj-class>
        <mj-class name="t-btn-primary" background-color="#{{ getBrandPrimaryColor() }}" color="#{{ getTextOnBrandColor() }}" font-size="16px"></mj-class>
        <mj-class name="t-section"></mj-class>
        <mj-class name="t-surface-1" background-color="#ffffff"></mj-class>
      </mj-attributes>
    </mj-head>
    <!-- BODY -->
    <mj-body background-color="#f4f4f4">
      <mj-section background-color="#ffffff">
        <mj-column>
          <mj-text font-size="11px" align="center">
            <p>
              <span data-fr-verified="true"><span data-fr-verified="true" class="atwho-inserted">{webview_text}</span>⁠⁠⁠⁠⁠⁠⁠</span>
            </p>
          </mj-text>
          <mj-spacer>
          </mj-spacer>
          <mj-image src="{{ getOverridableUrl('images/placeholder-logo.png') }}" width="70px">
          </mj-image>
        </mj-column>
      </mj-section>
      <mj-section background-color="#ffffff">
        <mj-column width="550px">
          <mj-text font-size="24px" font-weight="700">
            <p>Start customizing your email
            </p>
          </mj-text>
          <mj-text mj-class="t-body">
            <p>This is where you add your primary message. Keep it concise and engaging. Explain the purpose of your email and what action you want the reader to take.
            </p>
          </mj-text>
          <mj-button href="#" mj-class="t-btn t-btn-primary" align="left" border-radius="{{ getRoundedCorners('lg') }}px {{ getRoundedCorners('lg') }}px {{ getRoundedCorners('lg') }}px {{ getRoundedCorners('lg') }}px">Button
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding-top="0" padding-bottom="20px" background-color="#ffffff">
        <mj-column>
          <mj-spacer>
          </mj-spacer>
          <mj-text line-height="1.5" align="center" padding-top="0px" padding-bottom="0px" font-size="12px">
            <p>{brand=name}
              <br/>11111 Beautiful City, 1212 Nice Street
              <br/>Brazil
              <br/>
            </p>
          </mj-text>
          <mj-spacer>
          </mj-spacer>
          <mj-text font-size="11px" align="center" color="#6d6d6d">
            <p>Fancy seeing you down here. You’re getting this email because you gave us your email address.
            </p>
            <p>Want to change how you receive these emails?
            </p>
          </mj-text>
          <mj-text font-size="11px" align="center" color="#6d6d6d">
            <p>
              <span data-fr-verified="true"><span data-fr-verified="true" class="atwho-inserted">{unsubscribe_text}</span>⁠⁠⁠⁠⁠⁠⁠</span>
            </p>
          </mj-text>
          <mj-spacer height="60px">
          </mj-spacer>
        </mj-column>
      </mj-section>
      <!-- SECTION POLICY -->
    </mj-body>
  </mjml>
