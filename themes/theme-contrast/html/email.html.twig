<mjml>
    <mj-head>
        <mj-attributes>
            <!-- Global defaults -->
            <mj-all font-family="Georgia, Times, serif" color="#1F2937"></mj-all>
            <mj-text font-size="17px" line-height="26px" padding="0"></mj-text>
            <mj-button font-weight="700" border-radius="0px" padding="0"></mj-button>
            <mj-section padding="28px 0"></mj-section>
            <mj-column padding="0"></mj-column>

            <!-- Typography tokens -->
            <mj-class name="t-body" font-size="17px" line-height="26px"></mj-class>
            <mj-class name="t-lead" font-size="20px" line-height="30px"></mj-class>
            <mj-class name="t-h1" font-size="36px" line-height="42px" font-weight="700"></mj-class>
            <mj-class name="t-h2" font-size="28px" line-height="34px" font-weight="700"></mj-class>
            <mj-class name="t-h3" font-size="20px" line-height="26px" font-weight="700"></mj-class>
            <mj-class name="t-h4" font-size="17px" line-height="24px" font-weight="700"></mj-class>

            <!-- Button tokens -->
            <mj-class name="t-btn" inner-padding="14px 24px"></mj-class>
            <mj-class name="t-btn-primary" background-color="#DC2626" color="#FFFFFF"></mj-class>
            <mj-class name="t-btn-secondary" background-color="#1F2937" color="#FFFFFF"></mj-class>

            <!-- Surface tokens -->
            <mj-class name="t-section"></mj-class>
            <mj-class name="t-surface-1" background-color="#FFFBEB"></mj-class>
            <mj-class name="t-surface-2" background-color="#FEF3C7"></mj-class>
        </mj-attributes>
        <!--
          Note: mj-style has limited email client support (Outlook, Gmail strip it).
          Use only for non-critical enhancements. All essential styling must be in mj-attributes.
        -->
        <mj-style inline="inline">
            p, li { margin: 0; padding: 0; }
            a { color: #DC2626; }
        </mj-style>
    </mj-head>

    <mj-body background-color="#FEF3C7">
        <!-- Header -->
        <mj-section padding="16px 0">
            <mj-column>
                <mj-text align="center" font-size="11px" color="#92400E">
                    <a href="{webview_url}" style="color: #92400E;">View in browser</a>
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Main Content Area -->
        <mj-section mj-class="t-surface-1" padding="32px 24px">
            <mj-column>
                <mj-text mj-class="t-h1" padding-bottom="16px">
                    Welcome to Theme Contrast
                </mj-text>
                <mj-text mj-class="t-body" padding-bottom="24px">
                    This theme demonstrates the token-based styling system using mj-class attributes. Blocks dropped
                    from GrapesJS will inherit styles from the theme's mj-attributes definitions.
                </mj-text>
                <mj-button mj-class="t-btn t-btn-primary" href="https://">
                    Primary Button
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Secondary Section -->
        <mj-section mj-class="t-surface-2" padding="32px 24px">
            <mj-column>
                <mj-text mj-class="t-h2" padding-bottom="12px">
                    Secondary Section
                </mj-text>
                <mj-text mj-class="t-body" padding-bottom="24px">
                    This section uses the t-surface-2 token for a warm amber background. The button below uses the
                    secondary button styling.
                </mj-text>
                <mj-button mj-class="t-btn t-btn-secondary" href="https://">
                    Secondary Button
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="24px 0">
            <mj-column>
                <mj-text align="center" font-size="11px" color="#92400E" padding-bottom="8px">
                    Your Company Name | 123 Street, City
                </mj-text>
                <mj-text align="center" font-size="11px" color="#92400E">
                    {unsubscribe_text}
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
