<mjml>
  <!-- MJML Template ConfirmMe v2.0 / last update 25.07.2022 / tested with Litmus -->
  <mj-head>
    <mj-title>{subject}</mj-title>
    <!-- FONT IMPORT -->
    <mj-font name="Open Sans" href="https://fonts.googleapis.com/css2family=Open+Sans:wght@300;400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Open Sans, Arial" color="#6f6f6f" line-height="1.5" margin="0"></mj-all>
      <mj-button border-radius="3px" padding="10px 25px"></mj-button>
      <mj-section></mj-section>

      <mj-class name="t-body" font-size="16px"></mj-class>
      <mj-class name="t-btn" inner-padding="10px 25px"></mj-class>
      <mj-class name="t-btn-primary" background-color="#F45E43" color="#ffffff" font-size="15px" font-weight="500"></mj-class>
      <mj-class name="t-section"></mj-class>
      <mj-class name="t-surface-1" background-color="#f0f0f0"></mj-class>
    </mj-attributes>
    <!-- CSS-STYLE -->
    <mj-style inline="inline"> p, li {margin:0; padding:0;} </mj-style>
  </mj-head>
  <!-- BODY -->
  <mj-body css-class="graylink">
    <!-- SECTION HEADER -->
    <mj-section mj-class="t-surface-1">
      <mj-column width="400px">
        <mj-text align="center" font-size="24px" font-weight="700">
          <p>My Company</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- SECTION TEXT + BUTTON -->
    <mj-section background-color="#fafafa" padding-top="40px" padding-bottom="40px">
      <mj-column width="400px">
        <mj-text align="center" font-size="20px" font-weight="700">
          <p>Please confirm your subscription!</p>
        </mj-text>
        <mj-button mj-class="t-btn-primary" align="center" href="#">Yes, subscribe me to the list </mj-button>
        <mj-text mj-class="t-body" align="center" font-weight="500">
          <p><br><br>If you received this email by mistake, simply delete it. You won't be subscribed if you don't click the confirmation link above.</p>
          <br>
          <p>For questions about this list, please contact: <a style="color:#6f6f6f !important; text-decoration:underline;" title="our e-mail" href="mailto:email@email.com">email@email.com</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw>
      <!-- SECTION FOOTER -->
    </mj-raw>
    <mj-section mj-class="t-surface-1">
      <mj-column width="400px">
        <mj-text align="center" font-size="14px" font-weight="300">
          <p>{brand=name} <br>11111 Beautiful City<br> 1212 Nice Street <br>Switzerland <br></p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
