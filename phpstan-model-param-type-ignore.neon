# Two *Model methods whose single param is genuinely loose, so left untyped:
# IntegrationEntityModel::getRecordList (called with an extra arg + iterates ->getRecords())
# ImportModel::isEmptyCsvRow (defensive mixed row from CSV parsing)
parameters:
    ignoreErrors:
        -
            identifier: mautic.modelMethodSingleParamMustHaveType
            paths:
                - app/bundles/LeadBundle/Model/ImportModel.php
                - app/bundles/PluginBundle/Model/IntegrationEntityModel.php
