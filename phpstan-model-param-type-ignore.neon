# *Model methods whose single param is genuinely loose, so left untyped:
# CompanyModel/LeadModel::organizeFieldsByGroup (a Paginator or null is passed)
# PageModel::generateSlug (a VariantEntityInterface is passed)
parameters:
    ignoreErrors:
        -
            identifier: mautic.modelMethodSingleParamMustHaveType
            paths:
                - app/bundles/LeadBundle/Model/CompanyModel.php

        # generic base contracts handle any entity, so "object $entity" is correct and cannot name a concrete class
        -
            identifier: mautic.entityParamConcreteType
            paths:
                - app/bundles/CoreBundle/Model/FormModel.php
                - app/bundles/CoreBundle/Entity/CommonRepository.php
