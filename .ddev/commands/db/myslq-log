#!/bin/bash

## Description: Follow the MySQL/MariaDB general log.
## Usage: mysql-log
## Example: "ddev mysql-log"
## Flags: []
## DBTypes: mysql,mariadb
## Aliases: mariadb-log

logFile="/var/log/db-general.log"
mysql -u root -proot db -e "SET GLOBAL general_log_file='$logFile';SET GLOBAL general_log=ON;" && tail -f "$logFile"
